---
import MarketingLayout from '../layouts/MarketingLayout.astro';

export const prerender = true;
---

<MarketingLayout
  title="Page Not Found - Kindling"
  description="The page you're looking for doesn't exist or has been moved."
>
  <main class="page-padding page-main">
    <div class="container">
      <div class="error-code">404</div>
      <h1>Page not found</h1>
      <p>The page you're looking for doesn't exist or has been moved.</p>
      <a href="/" class="back-link">Back to Kindling</a>
    </div>
  </main>
</MarketingLayout>

<style>
  /* Page-specific styles only. Base styles in /assets/site.css */

  main.page-main {
    display: flex;
    justify-content: center;
    text-align: center;
  }

  .container {
    max-width: 560px;
  }

  .error-code {
    font-family: var(--font-display);
    font-size: 120px; /* decorative numeral, deliberately off-scale */
    font-weight: 700;
    color: var(--color-border);
    line-height: 1;
    margin-bottom: 16px;
  }

  h1 {
    font-family: var(--font-display);
    font-size: var(--text-h2);
    font-weight: 600;
    margin-bottom: 12px;
  }

  p {
    font-size: var(--text-body-lg);
    color: var(--color-text-muted);
    margin-bottom: 32px;
  }

  .back-link {
    display: inline-block;
    font-family: var(--font-ui);
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--color-on-accent);
    background: var(--color-accent);
    padding: 14px 28px;
    border-radius: var(--radius-m);
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .back-link:hover {
    opacity: 0.9;
  }
</style>

<script>
  if (typeof gtag === 'function') {
    gtag('event', 'page_not_found', {
      page_location: window.location.href,
      page_referrer: document.referrer
    });
  }
</script>
