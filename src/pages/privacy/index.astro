  .privacy-content ul { margin: 16px 0; padding-left: 24px; }
  .privacy-content li { margin-bottom: 8px; line-height: var(--leading); }
  .privacy-content hr { border: none; border-top: 1px solid var(--color-border); margin: 40px 0; }
</style>
