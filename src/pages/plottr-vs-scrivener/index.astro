            <td class="cross"><span class="sr-only">No</span><span aria-hidden="true">&#10007;</span></td>
            <td class="cross"><span class="sr-only">No</span><span aria-hidden="true">&#10007;</span></td>
          </tr>
          <tr>
            <th scope="row">Beat sheet templates</th>
            <td class="check"><span class="sr-only">Yes</span><span aria-hidden="true">&#10003;</span></td>
            <td class="cross"><span class="sr-only">No</span><span aria-hidden="true">&#10007;</span></td>
            <td class="check"><span class="sr-only">Yes</span><span aria-hidden="true">&#10003;</span></td>
          </tr>
          <tr>
            <th scope="row">Character arc tracking</th>
            <td class="check"><span class="sr-only">Yes</span><span aria-hidden="true">&#10003;</span></td>
            <td>Partial</td>
            <td class="check"><span class="sr-only">Yes</span><span aria-hidden="true">&#10003;</span></td>
          </tr>
          <tr>
            <th scope="row">Prose drafting</th>
            <td class="cross"><span class="sr-only">No</span><span aria-hidden="true">&#10007;</span></td>
            <td class="check"><span class="sr-only">Yes</span><span aria-hidden="true">&#10003;</span></td>
            <td class="check"><span class="sr-only">Yes</span><span aria-hidden="true">&#10003;</span></td>
          </tr>
          <tr>
            <th scope="row">Outline visible while drafting</th>
            <td>N/A</td>
            <td>Partial (inspector)</td>
