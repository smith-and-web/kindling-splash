---
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import { graph, softwareApplication } from '../../data/schema';
import SmartDownloadButton from '../../components/SmartDownloadButton.svelte';
import FaqSection from '../../components/FaqSection.astro';
import { APP_VERSION } from '../../data/downloads';

const structuredData = graph(softwareApplication({
  description: "Free, open-source fiction writing software that bridges Plottr's outlining and Scrivener's manuscript management. Import from both, draft with your outline visible.",
}));

// One source for the FAQPage markup and the visible FAQ (FaqSection), so the
// markup never describes a question the reader cannot see. This page owns the
// free-modifier Plottr queries ("plottr free alternative", "is plottr free"):
// operator decision 2026-10-05, recorded in the mktops content calendar.
const faqStructuredData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Is Plottr free?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Plottr has a 30-day free trial and no free plan. The cheapest plan is $60 a year or $150 lifetime for the Mac and Windows apps; Pro plans with the browser app and cloud sync cost more. If you want a free alternative that also drafts, kindling imports Plottr .pltr files and is free and open source."
      }
    },
    {
      "@type": "Question",
      "name": "Is Scrivener free?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Scrivener costs $59.99 once per desktop platform, macOS or Windows, and a second platform is $37.95. Its free trial lasts 30 days of actual use. Scrivener for iPhone and iPad is $23.99 and has no trial. There is no Linux version."
      }
    },
    {
      "@type": "Question",
      "name": "Can I use Plottr and Scrivener together?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, and many writers do: they plan in Plottr, export the outline, and draft in Scrivener. The cost is that the outline no longer lives where you write. You check it in another window while each new Scrivener document starts blank."
      }
    },
    {
      "@type": "Question",
      "name": "Does kindling replace Plottr or Scrivener?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "It can replace either, but it does not have to. kindling covers the step between them: drafting with your outline visible. You can plan in Plottr, draft in kindling, and export to Scrivener for revision and compiling. kindling has no visual timeline like Plottr's and no research folder like Scrivener's."
      }
    },
    {
      "@type": "Question",
      "name": "Can kindling import my Plottr file?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. kindling imports Plottr .pltr files directly. Timeline beats become prompts you write into, and characters and locations appear in the References panel while you draft."
      }
    },
    {
      "@type": "Question",
      "name": "Can kindling import and export Scrivener projects?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. kindling imports Scrivener 3 .scriv bundles, keeping the binder hierarchy, synopses and prose. It exports to a new .scriv bundle, or updates an existing one after showing you which scenes match."
      }
    },
    {
      "@type": "Question",
      "name": "Is kindling free?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. kindling is free and open source under the MIT licence, with no account, subscription or paid tier. It is a desktop app for macOS, Windows and Linux."
      }
    }
  ]
};
---

<MarketingLayout
  title="Plottr vs Scrivener (2026): Honest Comparison + Free Option"
  description="Plottr vs Scrivener for fiction writers: features, pricing and who each suits — plus how kindling bridges outlining and drafting for free."
  structuredData={structuredData}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqStructuredData)} />

  <!-- ===== Hero ===== -->
  <!-- The answer comes first: a reader who stops after the hero knows which
       tool fits, what each costs and that neither is free. -->
  <section class="page-hero">
    <h1>Plottr vs Scrivener: which is right for your novel?</h1>
    <p class="page-hero-subtext direct-answer">Choose Plottr if you plan visually before you write: it is the better outlining tool, but it has no prose editor. Choose Scrivener if you need to draft, revise and format a long manuscript: it is the better writing tool, with only basic outlining. Neither is free. Plottr costs $60 a year or $150 lifetime, and Scrivener $59.99 once per desktop platform. For a free option, kindling keeps your outline beside the draft.</p>
  </section>

  <!-- ===== Verdict ===== -->
  <section class="content-section" id="verdict">
    <p class="pw-label">02 / The verdict</p>
    <h2>Which one fits how you draft</h2>

    <h3>Choose Plottr if</h3>
    <ul>
      <li>You think in timelines, storylines and beat sheets before you write a word.</li>
      <li>You plan a series and want plot threads tracked across books.</li>
      <li>You are happy to draft in another app once the outline is done.</li>
    </ul>

    <h3>Choose Scrivener if</h3>
    <ul>
      <li>Your outline is light and you work it out in the draft.</li>
      <li>You keep research, PDFs and images beside the manuscript.</li>
      <li>You need precise compiled output for submission, print or ebook.</li>
    </ul>

    <h3>Choose neither, or add kindling, if</h3>
    <ul>
      <li>You want to write each scene with its beats in view, not in another window.</li>
      <li>You want something free, or you write on Linux, where neither runs.</li>
    </ul>
    <p>kindling imports Plottr and Scrivener files and exports back to Scrivener, so it can sit between them or replace either. <a href="#where-kindling-fits">See where it fits.</a></p>
  </section>

  <!-- ===== Pricing ===== -->
  <section class="content-section alt" id="pricing">
    <p class="pw-label">03 / Pricing</p>
    <h2>Plottr and Scrivener pricing in 2026</h2>
    <p>Prices checked 11 November 2026 on <a href="https://plottr.com/pricing/">Plottr’s pricing page</a> and <a href="https://www.literatureandlatte.com/store/scrivener">the Literature &amp; Latte store</a>, in USD before tax. Plottr shows a higher list price struck through beside most plans, and has for months; the figures here are the prices it charges.</p>
