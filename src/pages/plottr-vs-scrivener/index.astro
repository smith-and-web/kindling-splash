            <td class="cross"><span class="sr-only">No</span><span aria-hidden="true">&#10007;</span></td>
          </tr>
          <tr>
            <th scope="row">Import from other tools</th>
            <td><a href="https://docs.plottr.com/article/11-how-to-start-a-new-plottr-project">Scrivener, Word, Snowflake Pro</a></td>
            <td><a href="https://www.literatureandlatte.com/blog/scrivener-and-microsoft-word-importing-exporting">Word and other document formats</a></td>
            <td class="check"><span class="sr-only">Yes</span><span aria-hidden="true">&#10003;</span> (Plottr, Scrivener, yWriter, Obsidian, Markdown)</td>
          </tr>
