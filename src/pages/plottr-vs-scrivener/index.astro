---
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import { graph, softwareApplication } from '../../data/schema';
import SmartDownloadButton from '../../components/SmartDownloadButton.svelte';
import { APP_VERSION } from '../../data/downloads';

const structuredData = graph(softwareApplication({
  description: "Free, open-source fiction writing software that bridges Plottr's outlining and Scrivener's manuscript management. Import from both, draft with your outline visible.",
}));

const faqStructuredData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Can I use Plottr and Scrivener together?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, many writers plan in Plottr and draft in Scrivener. The typical workflow is to export your Plottr outline, then start a new Scrivener project and use the outline as reference. The downside is that your outline doesn't live inside your drafting space — you switch between two separate apps."
      }
    },
    {
      "@type": "Question",
      "name": "Does kindling replace Plottr or Scrivener?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Not necessarily. kindling bridges the gap between them. You can plan in Plottr, draft in kindling (with your outline visible), and export to Scrivener for revision and compilation. kindling imports from both Plottr and Scrivener and exports to Scrivener."
      }
    },
    {
      "@type": "Question",
      "name": "Can kindling import my Plottr file?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. kindling imports Plottr .pltr files directly, preserving your timeline beats, characters, locations, and scene cards. Your outline becomes expandable writing prompts in kindling's drafting view."
      }
    },
    {
      "@type": "Question",
      "name": "Can kindling import and export Scrivener projects?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. kindling can import Scrivener 3 .scriv bundles (preserving binder hierarchy, synopses, and prose) and export back to Scrivener — either as a new bundle or by updating an existing one with a match preview dialog."
      }
    },
    {
      "@type": "Question",
      "name": "Is kindling free?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. kindling is completely free and open source under the MIT license. No subscriptions, no feature gates. Desktop app for macOS, Windows, and Linux."
      }
    }
  ]
};
---

<MarketingLayout
  title="Plottr vs Scrivener (2026): Honest Comparison + Free Option"
  description="Plottr vs Scrivener for fiction writers: features, pricing and who each suits — plus how kindling bridges outlining and drafting for free."
  structuredData={structuredData}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqStructuredData)} />

  <!-- ===== Hero ===== -->
  <section class="page-hero">
    <h1>Plottr vs Scrivener: which is right for your novel?</h1>
    <p class="page-hero-subtext">Plottr is the better outlining tool. Scrivener is the better manuscript manager. Many writers use both &mdash; and kindling bridges the gap between them.</p>
  </section>

  <!-- ===== Comparison Table ===== -->
  <section class="content-section">
