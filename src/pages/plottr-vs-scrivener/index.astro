            <td>Basic</td>
            <td class="check"><span class="sr-only">Yes</span><span aria-hidden="true">&#10003;</span> (Plottr)</td>
            <td class="check"><span class="sr-only">Yes</span><span aria-hidden="true">&#10003;</span> (Plottr)</td>
          </tr>
          <tr>
            <th scope="row">Outline-to-draft transition</th>
            <td class="cross">Manual export</td>
            <td class="cross">Blank page</td>
            <td class="cross">Blank page</td>
            <td class="check">Outline in drafting view</td>
          </tr>
          <tr>
            <th scope="row">First draft writing</th>
