---
import MarketingLayout from '../../layouts/MarketingLayout.astro';
---

<!-- noindex: a form, not a page anyone searches for (230 words; Google had
     never crawled it). Out of the sitemap for the same reason; the footer still
     links it. -->
<MarketingLayout title="Send Feedback — kindling Writer" description="Help make kindling better. Report a bug, request a feature, or rate the app. Your feedback is anonymous." noindex>

  <!-- Cloudflare Turnstile (anti-spam) -->
  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

  <section class="page-hero">
    <h1>Send Us Feedback</h1>
    <p class="page-hero-subtext">Help us make kindling better for writers. Report a bug, request a feature, or let us know what you think. Your feedback is anonymous unless you choose to share your email.</p>
  </section>

  <section class="content-section">
    <div class="feedback-form-container">

      <!-- Tab selector -->
      <div class="ka-tablist feedback-tabs" role="tablist">
        <button role="tab" class="tab active" data-type="bug" aria-selected="true">Bug Report</button>
        <button role="tab" class="tab" data-type="feature" aria-selected="false">Feature Request</button>
        <button role="tab" class="tab" data-type="rating" aria-selected="false">Rate kindling</button>
      </div>

      <!-- Bug Report Form -->
      <div class="feedback-form visible" id="form-bug">
        <div class="ka-field form-group">
          <label for="bug-summary">Summary <span class="required">*</span></label>
          <input type="text" id="bug-summary" maxlength="120" placeholder="Briefly describe the issue">
          <span class="char-count"><span id="bug-summary-count">0</span>/120</span>
        </div>

        <div class="ka-field form-group">
          <label for="bug-description">What happened? <span class="required">*</span></label>
          <textarea id="bug-description" maxlength="2000" rows="5" placeholder="Describe what you were doing and what went wrong"></textarea>
          <span class="char-count"><span id="bug-desc-count">0</span>/2000</span>
        </div>

        <div class="ka-field form-group">
          <label for="bug-expected">What did you expect to happen?</label>
          <textarea id="bug-expected" maxlength="1000" rows="3" placeholder="Optional"></textarea>
        </div>

        <div class="ka-field form-group">
          <label>How severe is this? <span class="required">*</span></label>
          <div class="severity-options">
            <div class="ka-check od-row"><input type="radio" id="severity-minor" name="severity" value="minor"><label for="severity-minor">Minor annoyance</label></div>
            <div class="ka-check od-row"><input type="radio" id="severity-broken" name="severity" value="broken"><label for="severity-broken">Something's broken</label></div>
            <div class="ka-check od-row"><input type="radio" id="severity-crash" name="severity" value="crash"><label for="severity-crash">App crashed or data loss</label></div>
          </div>
        </div>
      </div>

      <!-- Feature Request Form -->
      <div class="feedback-form" id="form-feature">
        <div class="ka-field form-group">
          <label for="feature-title">Feature title <span class="required">*</span></label>
          <input type="text" id="feature-title" maxlength="120" placeholder="Name the feature">
          <span class="char-count"><span id="feature-title-count">0</span>/120</span>
        </div>

        <div class="ka-field form-group">
          <label for="feature-description">Describe the feature <span class="required">*</span></label>
          <textarea id="feature-description" maxlength="2000" rows="5" placeholder="What should this feature do?"></textarea>
          <span class="char-count"><span id="feature-desc-count">0</span>/2000</span>
        </div>

        <div class="ka-field form-group">
          <label for="feature-usecase">What problem would this solve for your writing?</label>
          <textarea id="feature-usecase" maxlength="1000" rows="3" placeholder="Optional"></textarea>
        </div>
      </div>

      <!-- Rating Form -->
      <div class="feedback-form" id="form-rating">
        <div class="ka-field form-group">
          <label>How would you rate kindling?</label>
          <div class="star-rating" id="star-rating"></div>
        </div>

        <div class="ka-field form-group">
          <label for="rating-comment">Any additional thoughts?</label>
          <textarea id="rating-comment" maxlength="2000" rows="4" placeholder="Optional"></textarea>
        </div>
      </div>

      <!-- Shared fields -->
      <div class="shared-fields">
        <div class="ka-field form-group">
          <label>Are you a current kindling user?</label>
          <div class="toggle-options">
            <div class="ka-check od-row"><input type="radio" id="is-user-yes" name="is-user" value="yes" checked><label for="is-user-yes">Yes</label></div>
            <div class="ka-check od-row"><input type="radio" id="is-user-no" name="is-user" value="no"><label for="is-user-no">No, just evaluating</label></div>
          </div>
        </div>

        <div class="ka-field form-group">
          <label for="feedback-os">Your operating system</label>
          <select id="feedback-os">
            <option value="unknown">Select...</option>
            <option value="macos">macOS</option>
            <option value="windows">Windows</option>
            <option value="linux">Linux</option>
          </select>
        </div>

        <div class="ka-field form-group">
          <label for="feedback-email">Email (optional — only if you'd like us to follow up)</label>
          <input type="email" id="feedback-email" placeholder="your@email.com">
        </div>
      </div>

      <!-- Honeypot field (hidden from real users) -->
      <div class="feedback-honeypot" aria-hidden="true">
        <input type="text" name="website" id="feedback-honeypot" tabindex="-1" autocomplete="off">
      </div>

      <!-- Turnstile widget -->
      <div class="cf-turnstile" data-sitekey="0x4AAAAAACkqRWHDozaF1dmj" data-theme="light"></div>

      <!-- Privacy disclosure -->
      <p class="ka-help privacy-note">
        This form collects your OS selection to help diagnose issues.
        No personal data is stored unless you provide your email.
        Please don't include personal information in your feedback.
        <a href="/privacy/">Privacy policy &rarr;</a>
      </p>

      <button type="button" id="submit-feedback" class="ka-button btn-submit">Send Feedback</button>

      <div class="ka-notice feedback-status" id="feedback-status" role="status" aria-live="polite"></div>
    </div>
  </section>

  <section class="cta-section">
    <h2>Haven't tried kindling yet?</h2>
    <p>Free, open source, no account required.</p>
    <div class="download-buttons single">
      <a href="/download/" class="pw-button" data-cta-location="feedback_bottom">Download kindling — Free</a>
    </div>
  </section>

  <script is:inline>
    const FEEDBACK_API_URL = 'https://2gcszmyn325n5yaey2poh72qbe0tkmre.lambda-url.ca-central-1.on.aws/';

    let currentType = 'bug';
    let formOpenedAt = new Date().toISOString();
    let selectedRating = 0;

    // Tab switching
    document.querySelectorAll('.feedback-tabs .tab').forEach(tab => {
      tab.addEventListener('click', () => {
        document.querySelectorAll('.feedback-tabs .tab').forEach(t => {
          t.classList.remove('active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');
        currentType = tab.dataset.type;

        document.querySelectorAll('.feedback-form').forEach(f => f.classList.remove('visible'));
        document.getElementById(`form-${currentType}`).classList.add('visible');

        // Reset status and form-opened timestamp when switching tabs
        const statusEl = document.getElementById('feedback-status');
        statusEl.classList.remove('visible');
        formOpenedAt = new Date().toISOString();
      });
    });

    // Character counters
    function setupCounter(inputId, counterId) {
      const input = document.getElementById(inputId);
      const counter = document.getElementById(counterId);
      if (input && counter) {
        input.addEventListener('input', () => {
          counter.textContent = input.value.length;
        });
      }
    }

    setupCounter('bug-summary', 'bug-summary-count');
    setupCounter('bug-description', 'bug-desc-count');
    setupCounter('feature-title', 'feature-title-count');
    setupCounter('feature-description', 'feature-desc-count');

    // Star rating
    const starContainer = document.getElementById('star-rating');
    for (let i = 1; i <= 5; i++) {
      const star = document.createElement('button');
      star.type = 'button';
      star.textContent = '\u2606'; // empty star
      star.className = 'star';
      star.dataset.value = i;
      star.setAttribute('aria-label', `${i} star${i > 1 ? 's' : ''}`);
      star.addEventListener('click', () => {
        selectedRating = i;
        starContainer.querySelectorAll('.star').forEach((s, idx) => {
          s.textContent = idx < i ? '\u2605' : '\u2606'; // filled vs empty star
          s.classList.toggle('active', idx < i);
        });
      });
      starContainer.appendChild(star);
    }

    // Auto-detect OS
    (function() {
      const osSelect = document.getElementById('feedback-os');
      const ua = navigator.userAgent.toLowerCase();
      if (ua.includes('mac')) osSelect.value = 'macos';
      else if (ua.includes('win')) osSelect.value = 'windows';
      else if (ua.includes('linux')) osSelect.value = 'linux';
    })();

    // Submit handler
    document.getElementById('submit-feedback').addEventListener('click', async () => {
      const statusEl = document.getElementById('feedback-status');
      const submitBtn = document.getElementById('submit-feedback');

      // Build payload based on current type
      const payload = {
        type: currentType,
        source: 'website',
        os: document.getElementById('feedback-os').value,
        appVersion: 'website',
        locale: navigator.language,
        website: document.getElementById('feedback-honeypot').value, // Honeypot
        formOpenedAt: formOpenedAt,
      };

      // Optional email
      const email = document.getElementById('feedback-email').value.trim();
      if (email) payload.email = email;

      // Type-specific fields + validation
      if (currentType === 'bug') {
        payload.summary = document.getElementById('bug-summary').value.trim();
        payload.message = document.getElementById('bug-description').value.trim();
        payload.expected = document.getElementById('bug-expected').value.trim();
        payload.severity = document.querySelector('input[name="severity"]:checked')?.value;

        if (!payload.summary || !payload.message || !payload.severity) {
          showStatus('Please fill in all required fields.', 'error');
          return;
        }
      } else if (currentType === 'feature') {
        payload.summary = document.getElementById('feature-title').value.trim();
        payload.message = document.getElementById('feature-description').value.trim();
        payload.useCase = document.getElementById('feature-usecase').value.trim();

        if (!payload.summary || !payload.message) {
          showStatus('Please fill in all required fields.', 'error');
          return;
        }
      } else if (currentType === 'rating') {
        if (selectedRating === 0) {
          showStatus('Please select a star rating.', 'error');
          return;
        }
        payload.rating = selectedRating;
        payload.message = document.getElementById('rating-comment').value.trim();
        payload.summary = `${selectedRating}-star rating`;
      }

      // Get Turnstile token
      const turnstileToken = document.querySelector('[name="cf-turnstile-response"]')?.value;
      if (turnstileToken) {
        payload.turnstileToken = turnstileToken;
      }

      // Submit
      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending...';

      try {
        const response = await fetch(FEEDBACK_API_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        if (response.ok) {
          showStatus('Thank you! Your feedback has been received.', 'success');
          resetForm();
        } else if (response.status === 429) {
          showStatus('Too many submissions. Please try again later.', 'error');
        } else {
          const data = await response.json().catch(() => ({}));
          showStatus(data.error || 'Something went wrong. Please try again.', 'error');
        }
      } catch (err) {
        showStatus('Network error. Please check your connection and try again.', 'error');
      }

      submitBtn.disabled = false;
      submitBtn.textContent = 'Send Feedback';

      // Reset Turnstile
      if (window.turnstile) {
        window.turnstile.reset();
      }
    });

    function showStatus(message, type) {
      const statusEl = document.getElementById('feedback-status');
      statusEl.textContent = message;
      statusEl.className = `ka-notice ka-notice--${type} feedback-status visible`;
    }

    function resetForm() {
      // Clear all inputs
      document.querySelectorAll('.feedback-form input[type="text"], .feedback-form textarea').forEach(el => {
        el.value = '';
      });
      document.querySelectorAll('.feedback-form input[type="radio"]').forEach(el => {
        el.checked = false;
      });
      // Reset star rating
      selectedRating = 0;
      starContainer.querySelectorAll('.star').forEach(s => {
        s.textContent = '\u2606';
        s.classList.remove('active');
      });
      // Reset character counters
      document.querySelectorAll('.char-count span[id]').forEach(el => {
        el.textContent = '0';
      });
      // Reset form opened timestamp
      formOpenedAt = new Date().toISOString();
    }
  </script>

</MarketingLayout>

<style>
  /* Arrangement only. The tab strip, fields, radio rows, submit action, status
     notice and every focus/invalid/disabled state come from `application.css` —
     the same controls a writer operates inside kindling. This page previously
     carried its own copy of all of them, which is the duplicate form language
     this adoption removes. */

  .feedback-form-container {
    max-width: 640px;
    margin: 0 auto;
  }

  .feedback-tabs { margin-bottom: var(--space-l); }

  .feedback-form { display: none; }
  .feedback-form.visible { display: block; }

  .form-group { margin-bottom: var(--space-m); }

  /* A required marker inside a field label. */
  .form-group .required { color: var(--color-accent-text); }

  .char-count {
    display: block;
    font-size: var(--text-eyebrow);
    color: var(--color-text-muted);
    text-align: right;
  }

  .severity-options,
  .toggle-options {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s) var(--space-m);
  }

  /* Star rating — no shared equivalent; a five-point scale of glyph buttons is
     this page's own control. It still meets the target contract and reads its
     colours from tokens. */
  .star-rating {
    display: flex;
    gap: var(--space-2xs);
  }

  .star-rating .star {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-inline-size: var(--control-target);
    min-block-size: var(--control-target);
    font-size: 32px; /* decorative star glyph, deliberately off-scale */
    background: none;
    border: none;
    color: var(--color-border);
    cursor: pointer;
    transition: color var(--transition), transform var(--transition-fast);
    line-height: 1;
  }

  .star-rating .star:hover,
  .star-rating .star.active {
    color: var(--color-accent);
    transform: scale(1.1);
  }

  .star-rating .star:focus-visible {
    outline: 2px solid var(--color-accent-text);
    outline-offset: 3px;
  }

  button.btn-submit {
    width: 100%;
    margin-top: var(--space-2xs);
  }

  /* An empty status must not draw a notice surface. */
  div.feedback-status { display: none; margin-top: var(--space-s); }
  div.feedback-status.visible { display: block; }

  .privacy-note {
    margin-block: var(--space-m);
    padding: var(--space-s);
    background: var(--color-surface);
    border-radius: var(--radius-m);
    border: 1px solid var(--color-border);
    font-family: var(--font-body);
    max-width: none;
  }

  /* Offscreen, not display:none: a hidden input is not submitted by some
     autofill agents, which is the whole point of the honeypot. */
  .feedback-honeypot { position: absolute; left: -9999px; }

  .cf-turnstile { margin-block: var(--space-s) var(--space-2xs); }

  .shared-fields {
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-m);
    margin-top: var(--space-l);
  }

  @media (max-width: 520px) {
    .severity-options {
      flex-direction: column;
    }
  }
</style>
