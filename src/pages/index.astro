---
import { Image } from 'astro:assets';
import MarketingLayout from '../layouts/MarketingLayout.astro';
import SmartDownloadButton from '../components/SmartDownloadButton.svelte';
import { APP_VERSION, DOWNLOADS } from '../data/downloads';
import scenePanel from '../assets/scene-panel.png';
import beatWithProse from '../assets/beat-with-prose.png';
import referencesPanel from '../assets/references-panel.png';

const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Kindling Writer",
  "description": "Free open-source fiction writing software that keeps your outline visible while you draft. Import from Plottr, Scrivener, yWriter, or Obsidian.",
  "url": "https://kindlingwriter.com/",
  "applicationCategory": "DesktopApplication",
  "operatingSystem": "Windows, macOS, Linux",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "author": {
    "@type": "Organization",
    "name": "Kindling",
    "url": "https://kindlingwriter.com"
  },
  "softwareVersion": APP_VERSION,
  "license": "https://opensource.org/licenses/MIT",
  "downloadUrl": "https://kindlingwriter.com/download/",
  "screenshot": "https://kindlingwriter.com/og-image.png"
};
---

<MarketingLayout
  title="Kindling Writer — Free Fiction Writing Software for Plotters & Pantsers"
  description="Kindling Writer is free fiction writing software that keeps your outline visible while you draft. Import from Plottr, Scrivener, yWriter, or Obsidian. Desktop app for macOS, Windows & Linux."
  structuredData={structuredData}
>
  <!-- Hero — two-column editorial lockup: statement left, static figure right -->
  <section class="hero editorial">
    <div class="hero-text">
      <h1>From outline to first draft</h1>
      <p class="tagline">Your outline, visible while you write</p>

      <!-- Smart Download CTA (hydrated client-side) -->
      <SmartDownloadButton client:load location="hero" />

      <p class="open-source-badge">v{APP_VERSION} · AI-free</p>
      <a class="hero-secondary" href="#how-it-works">or see how it works &rarr;</a>
    </div>

    <figure class="hero-figure">
      <Image src={scenePanel} alt="Kindling's scene editor showing synopsis, beats, and character references beside the draft" width={620} loading="eager" />
      <figcaption>One scene in Kindling — synopsis, beats, and character references sit beside the page you're drafting.</figcaption>
    </figure>
  </section>

  <!-- Social proof — demoted to a single quiet line, not a bordered billboard -->
  <section class="social-proof editorial fade-in-on-scroll">
    <p>Trusted by 2000+ writers · MIT Licensed · Built with Rust &amp; Tauri · macOS · Windows · Linux</p>
  </section>

  <!-- Problem Statement — the emotional beat: large Fraunces, left-aligned prose at measure -->
  <section class="problem-section has-grain fade-in-on-scroll">
    <div class="editorial">
      <div class="problem-inner">
        <span class="accent-rule" aria-hidden="true"></span>
        <h2>You planned every beat.<br>Then you opened a blank document.</h2>
        <p>Writing apps make you choose: outline <em>or</em> draft. Your beats live in Plottr, your manuscript in Scrivener, your notes in Obsidian. Kindling puts them all in one focused space — so your outline stays visible while you write.</p>
      </div>
    </div>
  </section>

  <!-- Features — an editorial sequence of figure + prose, hairline-separated -->
  <section class="features-section editorial" id="how-it-works">
    <header class="section-lead fade-in-on-scroll">
      <h2>Fiction writing software built for outline-driven novelists</h2>
      <p class="section-standfirst">Stop switching between apps. Kindling brings your planning and drafting into one focused space — where outlines become novels.</p>
    </header>

    <div class="feature-seq">
      <article class="feature-row fade-in-on-scroll">
        <figure class="feature-figure">
          <Image src={beatWithProse} alt="Kindling editor showing scene beats alongside prose" width={560} loading="lazy" />
        </figure>
        <div class="feature-prose">
          <p class="kicker">Core Feature</p>
          <h3>Outline-Aware Drafting</h3>
          <p class="feature-problem">Other apps make you flip between your outline and a blank page.</p>
          <p class="feature-solution">Kindling puts your scene beats right inside your writing space. Click a beat, write into it.</p>
        </div>
      </article>

      <article class="feature-row reverse fade-in-on-scroll">
        <div class="feature-prose">
          <p class="kicker">Stay in Flow</p>
          <h3>References Panel</h3>
          <p class="feature-problem">Was it green eyes or blue? What was the tavern called?</p>
          <p class="feature-solution">Characters and locations tagged in your scene auto-surface in a side panel.</p>
        </div>
        <figure class="feature-figure">
          <Image src={referencesPanel} alt="Kindling references panel showing character details" width={560} loading="lazy" />
        </figure>
      </article>

      <div class="feature-pair fade-in-on-scroll">
        <div class="feature-prose">
          <p class="kicker">Your Pace</p>
          <h3>Rolling Outline</h3>
          <p class="feature-problem">Not every scene needs the same level of planning.</p>
          <p class="feature-solution">Three planning states — Fixed, Flexible, Undefined — let you add structure at your own pace. <a href="/story-outlining-software/">Learn more &rarr;</a></p>
        </div>
        <div class="feature-prose">
          <p class="kicker">Your Tools</p>
          <h3>Import &amp; Export</h3>
          <p class="feature-problem">Your outline lives in Plottr. Your manuscript in Word. Your notes in Obsidian.</p>
          <p class="feature-solution">Import from Plottr, yWriter, Obsidian Longform, Scrivener, or Markdown. Export to DOCX, Markdown, Scrivener, or EPUB.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- v1.2 Spotlight — hairline-separated list, one terracotta moment (the pill) -->
  <section class="spotlight has-grain fade-in-on-scroll">
    <div class="editorial">
      <header class="section-lead">
        <span class="version-badge">New in v{APP_VERSION}</span>
        <h2>The biggest update yet</h2>
      </header>
      <div class="spotlight-list">
        <div class="spotlight-item">
          <h3>Light Theme</h3>
          <p>Automatic light/dark switching based on your OS preference, with manual override.</p>
        </div>
        <div class="spotlight-item">
          <h3>Full-Page Prose Editing</h3>
          <p>Draft in a full-page editor — not just beat-by-beat. Toggle between page view and beat view per scene.</p>
        </div>
        <div class="spotlight-item">
          <h3>Custom Fields &amp; Tags</h3>
          <p>Create typed fields on characters and locations. Organize with hierarchical tags and saved filters.</p>
        </div>
        <div class="spotlight-item">
          <h3>Screenplay Support</h3>
          <p>New screenplay project type with page count estimator, slugline input, and Save the Cat / Hero's Journey templates.</p>
        </div>
        <div class="spotlight-item">
          <h3>Scrivener Import &amp; Export</h3>
          <p>Bidirectional Scrivener workflow. Create new .scriv bundles or update existing ones with a match preview dialog.</p>
        </div>
        <div class="spotlight-item">
          <h3>Smart Reference Detection</h3>
          <p>Non-AI engine scans your prose for character, location, and item mentions. Suggestions surface automatically.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Bottom CTA — a short, ceremonial line: centering earns its place here -->
  <section class="bottom-cta fade-in-on-scroll">
    <div class="bottom-cta-container">
      <h2>Your outline is ready. Start writing.</h2>
      <SmartDownloadButton client:visible location="bottom" />
    </div>
  </section>
</MarketingLayout>

<style>
  /* ===== Hero — two-column editorial lockup ===== */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.92fr);
    gap: var(--space-2xl);
    align-items: start;
    padding-top: 112px;
    padding-bottom: var(--space-m);
  }

  .hero-text {
    max-width: 34rem;
  }

  .hero h1 {
    font-family: var(--font-display);
    font-size: var(--text-hero);
    font-weight: 600;
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    margin-bottom: var(--space-xs);
  }

  .tagline {
    font-family: var(--font-body);
    font-size: var(--text-body-lg);
    color: var(--color-text);
    line-height: var(--leading-relaxed);
    max-width: 28rem;
    margin-bottom: var(--space-l);
  }

  /* Left-align the download component inside the editorial hero (it centres
     itself by default for the stacked CTA sections). */
  .hero :global(.smart-download) {
    align-items: flex-start;
    width: auto;
  }
  .hero :global(.smart-download .micro-copy),
  .hero :global(.smart-download .alt-platforms) {
    text-align: left;
  }

  .open-source-badge {
    font-family: var(--font-ui);
    font-size: var(--text-small);
    color: var(--color-text-muted);
    letter-spacing: 0.01em;
    margin-top: var(--space-m);
  }

  .hero-secondary {
    display: inline-block;
    margin-top: var(--space-2xs);
    font-family: var(--font-ui);
    font-size: var(--text-ui);
    color: var(--color-accent-text);
    text-decoration: none;
  }
  .hero-secondary:hover { text-decoration: underline; }

  .hero-figure {
    margin: 0;
  }
  .hero-figure img {
    width: 100%;
    height: auto;
    max-height: 560px;
    object-fit: cover;
    object-position: top center;
    display: block;
    /* Mounted-print treatment (matches .feature-figure): raised-surface mat +
       hairline frame + soft lift, so the hero screenshot reads as a print on
       a board rather than flush to the paper. */
    border: 12px solid var(--color-surface);
    border-radius: var(--radius-l);
    box-shadow: 0 0 0 1px var(--color-border), var(--shadow-md);
  }
  .hero-figure figcaption {
    font-family: var(--font-body);
    font-style: italic;
    font-size: var(--text-small);
    color: var(--color-text-muted);
    line-height: var(--leading);
    margin-top: var(--space-s);
    max-width: 38ch;
  }

  @media (max-width: 860px) {
    .hero {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
      padding-top: 88px;
      text-align: center;
    }
    .hero-text { max-width: none; }
    .tagline { max-width: none; margin-left: auto; margin-right: auto; }
    .hero :global(.smart-download) { align-items: center; width: 100%; }
    .hero :global(.smart-download .micro-copy),
    .hero :global(.smart-download .alt-platforms) { text-align: center; }
    .hero-figure figcaption { max-width: none; text-align: center; }
  }

  /* ===== Social proof — one quiet line ===== */
  .social-proof {
    padding: 0 24px var(--space-3xl);
    text-align: center;
  }
  .social-proof p {
    font-family: var(--font-ui);
    font-size: var(--text-ui);
    color: var(--color-text-muted);
  }

  /* ===== Problem statement ===== */
  .problem-section {
    padding: var(--space-4xl) 0 var(--space-3xl);
    background: var(--color-surface-sunken);
  }
  .problem-inner {
    max-width: var(--measure);
  }
  .problem-section h2 {
    font-family: var(--font-display);
    font-size: var(--text-h1);
    font-weight: 600;
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    margin-bottom: var(--space-m);
  }
  .problem-section p {
    font-family: var(--font-body);
    font-size: var(--text-body-lg);
    color: var(--color-text);
    line-height: var(--leading-relaxed);
  }

  /* ===== Features section — uses shared .section-lead / .feature-seq ===== */
  .features-section {
    padding: var(--space-4xl) 0 var(--space-3xl);
  }

  /* ===== v1.2 spotlight — uses shared .spotlight-list; page-specific chrome ===== */
  /* Full-bleed recessed sunken band (content is held to width by the inner
     .editorial wrapper, matching .problem-section). With the problem band it
     sets a paper → sunken → paper → sunken rhythm so sections read as planes. */
  .spotlight {
    padding: var(--space-3xl) 0;
    background: var(--color-surface-sunken);
  }
  .spotlight .version-badge {
    display: inline-block;
    font-family: var(--font-ui);
    font-size: var(--text-eyebrow);
    font-weight: 600;
    color: var(--color-accent-text);
    background: color-mix(in srgb, var(--color-accent) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-accent) 30%, transparent);
    padding: 4px 12px;
    border-radius: var(--radius-pill);
    margin-bottom: var(--space-s);
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
  }
  .spotlight .section-lead h2 {
    font-size: var(--text-h2);
  }

  /* ===== Bottom CTA — ceremonial, centered ===== */
  /* Paper band (the spotlight above is sunken); the invitation itself sits on a
     raised panel that lifts off the page — a "card steps up" close. */
  .bottom-cta {
    padding: var(--space-3xl) 24px var(--space-4xl);
    background: var(--color-bg);
    text-align: center;
  }
  .bottom-cta-container {
    max-width: 560px;
    margin: 0 auto;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
    padding: var(--space-2xl) var(--space-xl);
    box-shadow: var(--shadow-md);
  }
  .bottom-cta h2 {
    font-family: var(--font-display);
    font-size: var(--text-h2);
    font-weight: 600;
    margin-bottom: var(--space-m);
  }
</style>
