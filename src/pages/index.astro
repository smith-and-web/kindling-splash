---
import { Image } from 'astro:assets';
import MarketingLayout from '../layouts/MarketingLayout.astro';
import SmartDownloadButton from '../components/SmartDownloadButton.svelte';
import { APP_VERSION } from '../data/downloads';
import WritingDemo from '../components/WritingDemo.astro';
import beatWithProse from '../assets/beat-with-prose.png';
import referencesPanel from '../assets/references-panel.png';
import planningStates from '../assets/planning-states.png';
import importFormats from '../assets/import-formats.png';

/* Product figures keep their whole frame. `.pw-image-frame` letterboxes inside
   a fixed `--pw-reference-ratio`, so giving it each capture's own intrinsic
   ratio means no crop and no letterbox — and, unlike the mounted print's
   `cover` default, no capture ratio that silently decides how much of the
   interface a visitor sees. */
const frame = (image: { width: number; height: number }) =>
  `--pw-reference-ratio: ${image.width} / ${image.height}`;

const features = [
  {
    image: beatWithProse,
    alt: 'The kindling editor showing scene beats alongside prose',
    kicker: 'Core feature',
    title: 'Outline-aware drafting',
    problem: 'Other apps make you flip between your outline and a blank page.',
  },
  {
    image: referencesPanel,
    alt: 'The kindling references panel showing character details',
    kicker: 'Stay in flow',
    title: 'References panel',
    problem: 'Was it green eyes or blue? What was the tavern called?',
  },
  {
    image: planningStates,
    alt: "A scene set to Flexible planning, with the chapter tree marking each scene's planning state",
    kicker: 'Your pace',
    title: 'Rolling outline',
    problem: 'Not every scene needs the same level of planning.',
  },
  {
    image: importFormats,
    alt: "kindling's import options, including novelWriter, Plottr, yWriter, Markdown, Longform and Scrivener",
    kicker: 'Your tools',
    title: 'Import and export',
    problem: 'Your outline lives in Plottr. Your manuscript in Word. Your notes in Obsidian.',
  },
];

const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "kindling Writer",
  "description": "Free open-source fiction writing software that keeps your outline visible while you draft. Import from Plottr, Scrivener, yWriter, or Obsidian.",
  "url": "https://kindlingwriter.com/",
  "applicationCategory": "DesktopApplication",
  "operatingSystem": "Windows, macOS, Linux",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "author": {
    "@type": "Organization",
    "name": "kindling",
    "url": "https://kindlingwriter.com"
  },
  "softwareVersion": APP_VERSION,
  "license": "https://opensource.org/licenses/MIT",
  "downloadUrl": "https://kindlingwriter.com/download/",
  "screenshot": "https://kindlingwriter.com/og-image.png"
};
---

<MarketingLayout
  title="kindling Writer — Free Fiction Writing Software for Plotters & Pantsers"
  description="kindling Writer is free fiction writing software that keeps your outline visible while you draft. Import from Plottr, Scrivener, yWriter, or Obsidian. Desktop app for macOS, Windows & Linux."
  structuredData={structuredData}
>
  <!-- The introduction stays at reading measure; the sample scene breaks wider. -->
  <section class="pw-hero pw-frame hero" aria-labelledby="hero-title">
    <div class="pw-hero-grid">
      <h1 class="pw-hero-title" id="hero-title">Keep your outline close. <em>Keep writing.</em></h1>
      <div class="pw-stack">
        <p class="hero-tagline">Draft one scene at a time, with your beats, characters, and notes close at hand.</p>
        <SmartDownloadButton client:load location="hero" compact />
      </div>
    </div>
    <WritingDemo />
  </section>

  <!-- Social proof — the shared full-bleed band. Deliberately not
       .fade-in-on-scroll: it sits at the fold, where a scroll-driven reveal
       parks part-way through its range, and a band at the fold has nothing
       left to reveal. -->
  <section class="pw-band trust-band" aria-label="About kindling">
    <ul class="pw-trust pw-frame">
      <li>Trusted by 2000+ writers</li>
      <li>MIT licensed</li>
      <li>Built with Rust &amp; Tauri</li>
      <li>macOS · Windows · Linux</li>
    </ul>
  </section>

  <!-- Problem statement — the emotional beat. The heading is this section's
       display moment and breaks out wider than the prose beside it. -->
  <section class="problem-section has-grain fade-in-on-scroll">
    <div class="pw-frame">
      <div class="pw-section-head">
        <p class="pw-label">02 / From plan to page</p>
        <div>
          <h2 class="pw-heading">You planned every beat.<br>Then you opened a blank document.</h2>
          <p class="pw-prose">Writing apps make you choose: outline <em>or</em> draft. Your beats live in Plottr, your manuscript in Scrivener, your notes in Obsidian. kindling puts them all in one focused space — so your outline stays visible while you write.</p>
          <p class="pw-quote">An outline you can’t see while you write is just a document you wrote once.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Features — the shared sequence: full-width alternating rows, hairline
       separated, each carrying a print folio. Never a tile matrix. -->
  <section class="pw-frame features-section" id="how-it-works">
    <div class="pw-section-head fade-in-on-scroll">
      <p class="pw-label">03 / Close at hand</p>
      <div>
        <h2 class="pw-heading">Fiction writing software built for outline-driven novelists</h2>
        <p class="pw-prose">Stop switching between apps. kindling brings your planning and drafting into one focused space — where outlines become novels.</p>
      </div>
    </div>

    <div class="pw-feature-grid">
      {features.map((feature, index) => (
        <article class:list={['pw-feature', 'fade-in-on-scroll', { 'pw-feature--reverse': index % 2 === 1 }]}>
          <figure>
            <div class="pw-image-frame" style={frame(feature.image)}>
              <Image src={feature.image} alt={feature.alt} width={560} loading="lazy" />
            </div>
          </figure>
          <div>
            <p class="pw-label">{feature.kicker}</p>
            <h3 class="pw-feature-title">{feature.title}</h3>
            <p class="pw-problem">{feature.problem}</p>
            {index === 0 && <p>kindling puts your scene beats right inside your writing space. Click a beat, write into it.</p>}
            {index === 1 && <p>Characters and locations tagged in your scene auto-surface in a side panel.</p>}
            {index === 2 && <p>Three planning states — Fixed, Flexible, Undefined — let you add structure at your own pace. <a href="/story-outlining-software/">Learn more &rarr;</a></p>}
            {index === 3 && <p>Import from Plottr, yWriter, Obsidian Longform, Scrivener, novelWriter, or Markdown. Export to DOCX, Markdown, Longform, Scrivener, novelWriter, or EPUB.</p>}
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- v1.3 spotlight — the shared release rows under a running "04 /" label -->
  <section class="spotlight has-grain fade-in-on-scroll">
    <div class="pw-frame">
      <div class="pw-section-head">
        <p class="pw-label">04 / New in v{APP_VERSION}</p>
        <div>
          <h2 class="pw-section-title pw-heading">Keep writing. Bring your editor along.</h2>
          <p class="pw-prose">Meet Press, kindling’s new editorial design, with manuscript review and writing tools that keep you close to your story.</p>
        </div>
      </div>
      <div class="pw-release-grid">
        <div class="pw-release-item">
          <h3>Meet Press</h3>
          <p>A new design for kindling and its website: warm paper, bookish type, and clear, quiet controls. Light and dark themes bring the same care to your writing space.</p>
          <a class="pw-link" href="/blog/kindling-v1-3-writing-and-review/#meet-press">Take a first look &rarr;</a>
        </div>
        <div class="pw-release-item">
          <h3>Editorial review without accounts</h3>
          <p>Send your manuscript as a local file. Exchange tracked suggestions and comments, then decide what belongs in your story.</p>
          <a class="pw-link" href="/docs/editorial-review/">Explore editorial review &rarr;</a>
        </div>
        <div class="pw-release-item">
          <h3>Writing goals and statistics</h3>
          <p>Set a daily goal, follow your session totals, and see how your manuscript is taking shape, scene by scene.</p>
          <a class="pw-link" href="/docs/writing-progress/">See how progress is counted &rarr;</a>
        </div>
        <div class="pw-release-item">
          <h3>Pick up the thread</h3>
          <p>Read the previous scene’s synopsis and closing sentences. Reopen a project at your last scene, cursor, and scroll position.</p>
          <a class="pw-link" href="/docs/scene-workflow/#previous-scene-context">Return to your draft &rarr;</a>
        </div>
        <div class="pw-release-item">
          <h3>Custom exports for your next reader</h3>
          <p>Save an export profile for your agent, writing group, or website. Choose chapters, adjust the layout, and preview your manuscript. Simple exports are still available.</p>
          <a class="pw-link" href="/docs/export-workspace/">Make an export your own &rarr;</a>
        </div>
        <div class="pw-release-item">
          <h3>Carry your story world forward</h3>
          <p>Copy references, custom fields, and tags into another project. Each book’s characters and notes can evolve independently.</p>
          <a class="pw-link" href="/docs/references/#copying-references-between-projects">Copy references between books &rarr;</a>
        </div>
        <div class="pw-release-item">
          <h3>A novelWriter workflow</h3>
          <p>Import and export novelWriter projects, then compare incoming prose and choose which changes to bring into kindling.</p>
          <a class="pw-link" href="/docs/importing-projects/#novelwriter-project-folder">Bring your novelWriter project &rarr;</a>
        </div>
        <div class="pw-release-item">
          <h3>One place for settings</h3>
          <p>Appearance, author details, and project preferences share one window. Configure another book without leaving your manuscript, and <a href="/docs/settings/#keyboard-shortcuts">customize shortcuts</a> to suit the way you write.</p>
        </div>
      </div>
      <p class="release-link"><a href="/blog/kindling-v1-3-writing-and-review/">Read the v1.3 release story &rarr;</a></p>
    </div>
  </section>

  <!-- Closing action — the shared pattern. One primary fill in view. -->
  <section class="pw-closing pw-frame fade-in-on-scroll">
    <h2 class="pw-section-title">Your outline is ready. Start writing.</h2>
    <div class="pw-closing-actions">
      <SmartDownloadButton client:visible location="bottom" />
    </div>
  </section>
</MarketingLayout>

<style>
  /* Page arrangement only: band rhythm, opening space and the two editorial
     breaks. Every surface, hairline, type role and control below comes from
     the shared website layer. */
  .hero {
    padding-top: var(--space-4xl);
    padding-bottom: var(--space-l);
  }
  .hero .pw-hero-grid { margin-bottom: var(--space-xl); }
  .hero-tagline {
    font-family: var(--font-body);
    font-size: var(--text-body-lg);
    color: var(--color-text);
    line-height: var(--leading-relaxed);
    max-width: var(--measure);
    text-wrap: balance;
  }

  /* The trailing gap before the problem band is the only page business here. */
  .trust-band { margin-bottom: var(--space-3xl); }

  /* ===== Problem statement ===== */
  /* Full-bleed sunken plane; the inner .pw-frame holds content to width. With
     the spotlight below it this sets a paper → sunken → paper → sunken rhythm
     so sections read as planes rather than a scroll of undivided copy. */
  .problem-section {
    padding: var(--space-4xl) var(--space-l) var(--space-3xl);
    background: var(--color-surface-sunken);
  }
  .problem-section h2 {
    font-size: var(--text-h1);
    margin-bottom: var(--space-m);
    max-width: 30ch;
  }

  .features-section {
    padding-block: var(--space-4xl) var(--space-3xl);
  }
  .features-section .pw-section-head { margin-bottom: var(--space-l); }

  .spotlight {
    padding: var(--space-3xl) var(--space-l);
    background: var(--color-surface-sunken);
  }
  .spotlight .pw-section-head { margin-bottom: var(--space-l); }
  .release-link {
    margin-top: var(--space-xl);
    max-width: var(--measure);
  }

  /* `.pw-closing` puts the action beside the heading, so the download stack
     reads from the same left edge as its column rather than centring in it. */
  .pw-closing-actions :global(.smart-download) {
    align-items: flex-start;
    text-align: left;
  }
  .pw-closing-actions :global(.micro-copy) { text-align: left; }
</style>
