---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import SmartDownloadButton from '../components/SmartDownloadButton.svelte';
import { APP_VERSION } from '../data/downloads';
import emblem from '../vendor/press/assets/svg/kindling-mark.svg?raw';
import WritingDemo from '../components/WritingDemo.astro';
import ProductFigure from '../components/ProductFigure.astro';
import beatWithProse from '../assets/beat-with-prose.png';
import referencesPanel from '../assets/references-panel.png';
import planningStates from '../assets/planning-states.png';
import importFormats from '../assets/import-formats.png';

/*
 * Rebuilt on Press 0.12.0 from prototypes/home/. The eight problems it fixes
 * are recorded in prototypes/home/NOTES.md, measured against the previous
 * version of this page; the thirteen local overrides that prototype needed were
 * resolved upstream in Press 0.12.0 rather than carried here.
 *
 * The per-row `.pw-label` kickers are deliberately gone. Each row already
 * carries a folio number from `.pw-feature`'s own counter, inside a section
 * that already has a running "03 /" label — three labelling systems, and none
 * of "Core feature" / "Stay in flow" / "Your pace" / "Your tools" said anything
 * its title did not.
 */
const features = [
  {
    image: beatWithProse,
    alt: 'The kindling editor showing scene beats alongside prose',
    title: 'Outline-aware drafting',
    problem: 'Other apps make you flip between your outline and a blank page.',
    answer:
      'kindling puts your scene beats right inside your writing space. Click a beat, write into it.',
  },
  {
    image: referencesPanel,
    alt: 'The kindling references panel showing character details',
    title: 'References panel',
    problem: 'Was it green eyes or blue? What was the tavern called?',
    answer:
      'Characters and locations tagged in your scene auto-surface in a side panel.',
  },
  {
    image: planningStates,
    alt: "A scene set to Flexible planning, with the chapter tree marking each scene's planning state",
    title: 'Rolling outline',
    problem: 'Not every scene needs the same level of planning.',
    answer: null,
  },
  {
    image: importFormats,
    alt: "kindling's import options, including novelWriter, Plottr, yWriter, Markdown, Longform and Scrivener",
    title: 'Import and export',
    problem: 'Your outline lives in Plottr. Your manuscript in Word. Your notes in Obsidian.',
    answer:
      'Import from Plottr, yWriter, Obsidian Longform, Scrivener, novelWriter, or Markdown. Export to DOCX, Markdown, Longform, Scrivener, novelWriter, or EPUB.',
  },
];

// The emblem's intrinsic size, read from the asset as the Navbar does for the
// wordmark, so the <img> reserves the right box before the SVG arrives.
const emblemBox = emblem.match(/viewBox="0 0 ([\d.]+) ([\d.]+)"/);
const emblemWidth = Number(emblemBox?.[1] ?? 740.5);
const emblemHeight = Number(emblemBox?.[2] ?? 419.5);

const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "kindling Writer",
  "description": "Free open-source fiction writing software that keeps your outline visible while you draft. Import from Plottr, Scrivener, yWriter, or Obsidian.",
  "url": "https://kindlingwriter.com/",
  "applicationCategory": "DesktopApplication",
  "operatingSystem": "Windows, macOS, Linux",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "author": {
    "@type": "Organization",
    "name": "kindling",
    "url": "https://kindlingwriter.com"
  },
  "softwareVersion": APP_VERSION,
  "license": "https://opensource.org/licenses/MIT",
  "downloadUrl": "https://kindlingwriter.com/download/",
  "screenshot": "https://kindlingwriter.com/og-image.png"
};
---

<MarketingLayout
  title="kindling Writer — Free Fiction Writing Software for Plotters & Pantsers"
  description="kindling Writer is free fiction writing software that keeps your outline visible while you draft. Import from Plottr, Scrivener, yWriter, or Obsidian. Desktop app for macOS, Windows & Linux."
  structuredData={structuredData}
>
  <!-- 01 — the opener carries no running label, as on every other page.
       The explaining sentence sits under the headline it explains, at reading
       measure, on the page's one left edge; the narrow track carries ancillary
       matter only. Two terracotta moments in this viewport: the accent clause
       and the one filled action. The masthead's Download is secondary. -->
  <section class="pw-hero pw-frame hero" aria-labelledby="hero-title">
    <div class="pw-hero-grid pw-hero-grid--top">
      <div class="hero-stack">
        <h1 class="pw-hero-title" id="hero-title">Keep your outline close. <em>Keep writing.</em></h1>
        <p class="pw-prose">Draft one scene at a time, with your beats, characters, and notes close at hand. kindling is a desktop writing app that keeps the plan you made beside the page you are writing.</p>
        <SmartDownloadButton client:load location="hero" compact />
      </div>

      <!-- The download page's release card, turned toward the visitor: the same
           `.ka-panel` / `.ka-facts` / `.pw-version` pieces, with what kindling
           gives a writer where that card lists what the file is. The facts
           carry only what the trust strip below does not.
           The book-and-flame emblem is the supplied asset, unaltered; its ember
           is the original logo, exempt from the terracotta budget. Decorative —
           the masthead wordmark already names kindling — so it has an empty
           alt. The release link is an inline link, also exempt. -->
      <aside class="hero-aside" aria-label={`About kindling ${APP_VERSION}`}>
        <div class="ka-panel">
          <header class="ka-between hero-card-head">
            <img class="hero-mark" src="/brand/kindling-mark.svg" width={emblemWidth} height={emblemHeight} alt="" />
            <span class="pw-version">v{APP_VERSION}</span>
          </header>
          <div class="ka-panel-body hero-card-body">
            <p class="pw-prose">From first outline to finished draft. Free, and yours to keep.</p>
            <dl class="ka-facts">
              <div><dt>Works</dt><dd>Fully offline</dd></div>
              <div><dt>Your files</dt><dd>Stay yours</dd></div>
              <div><dt>Imports</dt><dd>Plottr, Scrivener and more</dd></div>
            </dl>
            <a class="pw-link" href="/blog/kindling-v1-3-writing-and-review/">See what&rsquo;s new in {APP_VERSION.replace(/\.0$/, '')} &rarr;</a>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <!-- The specimen, below the action rather than above it. It keeps its
       behaviour and loses its rank: a visitor is told what kindling is before
       being handed something to operate. -->
  <section class="pw-frame specimen" aria-label="A scene in kindling">
    <WritingDemo />
  </section>

  <!-- The fact strip. Left-aligned per `.pw-trust--inline`; the writer count is
       sourced from GitHub release analytics filtered to binary assets and is
       conservative — see press/docs/WEBSITE_COMPONENTS.md, corrected in 0.12.0. -->
  <section class="pw-band trust-band" aria-label="About kindling">
    <ul class="pw-trust pw-trust--inline pw-frame">
      <li>Trusted by 2000+ writers</li>
      <li>MIT licensed, open source</li>
      <li>macOS · Windows · Linux</li>
      <li>No account, no subscription, no AI</li>
    </ul>
  </section>

  <!-- 02 — the problem. The strongest section on the page before this pass and
       kept intact, minus the hard <br>, so `.pw-heading` can balance at width. -->
  <section class="pw-band--sunken has-grain" aria-labelledby="problem-title">
    <div class="pw-frame">
      <div class="pw-section-head">
        <p class="pw-label">02 / From plan to page</p>
        <div>
          <h2 class="pw-heading" id="problem-title">You planned every beat. Then you opened a blank document.</h2>
          <p class="pw-prose">Writing apps make you choose: outline <em>or</em> draft. Your beats live in Plottr, your manuscript in Scrivener, your notes in Obsidian. kindling puts them all in one focused space — so your outline stays visible while you write.</p>
          <p class="pw-quote">An outline you can’t see while you write is just a document you wrote once.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 03 — the sequence. One ratio for the whole run: four captures at their
       own ratios stand 424/424/272/424px tall in one column, and a run of rows
       each individually correct reads as ragged. `.pw-image-frame` contains
       rather than crops, so nothing is lost to the even frame. -->
  <section class="pw-frame features-section" id="how-it-works" aria-labelledby="features-title">
    <div class="pw-section-head">
      <p class="pw-label">03 / Close at hand</p>
      <div>
        <h2 class="pw-heading" id="features-title">Fiction writing software built for outline-driven novelists</h2>
        <p class="pw-prose">Stop switching between apps. kindling brings your planning and drafting into one focused space — where outlines become novels.</p>
      </div>
    </div>

    <div class="pw-feature-grid feature-run">
      {features.map((feature, index) => (
        <article class:list={['pw-feature', { 'pw-feature--reverse': index % 2 === 1 }]}>
          <ProductFigure src={feature.image} alt={feature.alt} ratio="inherit" />
          <div>
            <h3 class="pw-feature-title">{feature.title}</h3>
            <p class="pw-problem">{feature.problem}</p>
            {feature.answer && <p>{feature.answer}</p>}
            {index === 2 && (
              <p>Three planning states — Fixed, Flexible, Undefined — let you add structure at your own pace. <a href="/story-outlining-software/">Learn more &rarr;</a></p>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- 04 — the trailer for the release story, not the changelog. This ran to
       eight items, each with its own terracotta link: about as tall as the
       whole feature sequence above it, and the release story has its own page. -->
  <section class="pw-band--sunken has-grain" aria-labelledby="whats-new-title">
    <div class="pw-frame">
      <div class="pw-section-head">
        <p class="pw-label">04 / New in v{APP_VERSION}</p>
        <div>
          <h2 class="pw-heading" id="whats-new-title">Keep writing. Bring your editor along.</h2>
          <p class="pw-prose">Manuscript review, writing goals, and a new editorial design that carries the same care into every surface.</p>
        </div>
      </div>

      <div class="pw-release-grid">
        <div class="pw-release-item">
          <h3>Editorial review without accounts</h3>
          <p>Send your manuscript as a local file. Exchange tracked suggestions and comments, then decide what belongs in your story.</p>
          <a class="pw-link" href="/docs/editorial-review/">Explore editorial review &rarr;</a>
        </div>
        <div class="pw-release-item">
          <h3>Writing goals and statistics</h3>
          <p>Set a daily goal, follow your session totals, and see how your manuscript is taking shape, scene by scene.</p>
          <a class="pw-link" href="/docs/writing-progress/">See how progress is counted &rarr;</a>
        </div>
        <div class="pw-release-item">
          <h3>Pick up the thread</h3>
          <p>Read the previous scene’s synopsis and closing sentences. Reopen a project at your last scene, cursor, and scroll position.</p>
          <a class="pw-link" href="/docs/scene-workflow/#previous-scene-context">Return to your draft &rarr;</a>
        </div>
        <div class="pw-release-item">
          <h3>Meet Press</h3>
          <p>A new design for kindling and its website: warm paper, bookish type, and clear, quiet controls that read the same in the app and out of it.</p>
          <a class="pw-link" href="/blog/kindling-v1-3-writing-and-review/#meet-press">Take a first look &rarr;</a>
        </div>
      </div>

      <p class="section-foot">Custom export profiles, reference copying between projects, a novelWriter workflow, and one place for settings also landed in v{APP_VERSION}. <a href="/blog/kindling-v1-3-writing-and-review/">Read the release story &rarr;</a></p>
    </div>
  </section>

  <!-- 05 — closing. One primary fill, on the page's one left edge. -->
  <section class="pw-closing pw-frame" aria-labelledby="closing-title">
    <div>
      <h2 class="pw-section-title" id="closing-title">Your outline is ready. Start writing.</h2>
    </div>
    <div class="pw-closing-actions">
      <SmartDownloadButton client:visible location="bottom" />
    </div>
  </section>
</MarketingLayout>

<style>
  /* Page arrangement only. Band rhythm, the hero's two stacks and the
     sequence's shared figure ratio — every surface, hairline, type role and
     control comes from Press 0.12.0.

     DO NOT prefix these with `.press-web`. Astro stamps its scope hash only on
     elements in THIS component's template, and `.press-web` is in
     MarketingLayout — so `.press-web .hero-stack` compiles to
     `.press-web:where(.astro-hash) .hero-stack:where(.astro-hash)` and matches
     nothing at all. A whole block of arrangement silently did nothing while the
     page still looked plausible.

     Where a rule must beat a Press rule, qualify with the element name instead:
     Astro's `:where()` adds no specificity, so a bare class only ties with
     `.press-web .pw-thing` (0,2,0) and loses on source order. See CLAUDE.md,
     "Astro scoped styles have zero specificity". */

  /* `--pw-hero-measure` replaces Press's 15ch default, which breaks this
     37-character headline as "Keep your outline / close. / Keep writing." —
     a two-word middle line with room to spare.

     `--pw-hero-columns` aligns the hero's narrow track with the references
     inspector of the workspace specimen directly below it, so the inspector's
     divider reads as one line running the height of the page rather than as a
     second vertical a few pixels off the hero's.

     The arithmetic is the demo's: WritingDemo.astro sets the inspector to
     `clamp(15rem, 27cqi, 21rem)` of the workspace, flush with the frame's
     right edge, and `.ka-workspace-body` insets its content by `--space-s`.
     The hero spans the same frame, so its first track is the frame minus that
     inspector plus the inset, with no gap — the aside's text lands on the
     references content edge. (27% of the hero stands in for 27cqi of the
     workspace; the two differ by the workspace's 2px of border, under a pixel
     after the percentage.) Change the two together. Below a 900px workspace the specimen shows
     one region, so there is no inspector to align with; Press's narrow-width
     rules stack the hero below 600px without restating them here. */
  .hero {
    --pw-hero-measure: 18ch;
    --pw-hero-columns: calc(100% - clamp(15rem, 27%, 21rem) + var(--space-s)) minmax(0, 1fr);
    --pw-hero-gap: 0;
  }

  .hero-stack {
    display: grid;
    gap: var(--space-m);
    justify-items: start;
  }

  /* The hero's action stacks: one button, then its micro-copy, then the
     platforms link. The compact default is a two-column grid with the link
     beside the button — right in a tight column, wrong here, where it reads as
     a second action competing with the primary fill. Element-qualified to beat
     the Svelte component's own `.smart-download.compact` (0,3,0). */
  div.hero-stack :global(div.smart-download.compact) {
    grid-template-columns: minmax(0, 1fr);
    justify-items: start;
    gap: var(--space-2xs);
  }
  div.hero-stack :global(div.smart-download.compact .alt-platforms) {
    grid-column: 1;
    grid-row: 3;
  }

  /* The card starts on the headline's top edge and runs the height of the
     opening, so the hero reads as two stacks side by side rather than a
     headline with a footnote. Reset wherever the grid stacks and the card
     follows the stack in flow. */
  .hero-aside {
    align-self: start;
    min-width: 0;
  }

  /* The emblem at 40px, DESIGN.md's preferred floor for the book-and-flame.
     The header's own 16px padding clears the quarter-height clear space. */
  img.hero-mark {
    block-size: var(--space-xl);
    inline-size: auto;
  }

  header.hero-card-head { align-items: center; }

  div.hero-card-body {
    display: grid;
    gap: var(--space-s);
  }

  /* The link closes the card; the panel body's padding already sits under it. */
  div.hero-card-body a.pw-link { justify-self: start; }

  .specimen { padding-bottom: var(--space-3xl); }

  /* The strip sits directly on top of the 02 band, not below the specimen with
     a gap after it. It is a set of claims about the product, so it reads as the
     lead-in to the section that argues for them. */
  .trust-band { margin-top: var(--space-3xl); }

  .features-section { padding-block: var(--space-3xl); }

  /* One ratio for the run — see the section comment and ProductFigure's
     `ratio` prop. `.pw-feature-grid` sets this variable at (0,2,0), so the
     element qualifier is load-bearing, not decoration. */
  div.pw-feature-grid.feature-run { --pw-reference-ratio: 3 / 2; }

  .section-foot {
    margin-top: var(--space-2xl);
    padding-top: var(--space-m);
    border-top: var(--pw-line);
    max-width: var(--measure);
  }

  /* `.pw-closing` puts the action beside the heading, so the download stack
     reads from the same left edge as its column rather than centring in it. */
  .pw-closing-actions :global(.smart-download) {
    align-items: flex-start;
    text-align: left;
  }
  .pw-closing-actions :global(.micro-copy) { text-align: left; }

  @container press-website (max-width: 600px) {
    .specimen { padding-bottom: var(--space-2xl); }
    .trust-band { margin-top: var(--space-2xl); }
    .features-section { padding-block: var(--space-2xl); }
  }
</style>
