---
import { Image } from 'astro:assets';
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import { APP_VERSION } from '../../data/downloads';
import scenePanel from '../../assets/scene-panel.png';
import referencesPanel from '../../assets/references-panel.png';

const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Kindling Writer",
  "description": "Free, open-source fiction writing software that keeps your outline visible while you draft. Built for plotters, pantsers, and every kind of fiction writer.",
  "url": "https://kindlingwriter.com/",
  "applicationCategory": "DesktopApplication",
  "operatingSystem": "Windows, macOS, Linux",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "softwareVersion": APP_VERSION,
  "license": "https://opensource.org/licenses/MIT",
  "downloadUrl": "https://kindlingwriter.com/download/",
  "screenshot": "https://kindlingwriter.com/og-image.png",
  "author": {
    "@type": "Organization",
    "name": "Kindling",
    "url": "https://kindlingwriter.com"
  },
  "featureList": [
    "Rolling Outline Mode — progressive structure for plotters and plantsers",
    "Blank projects — start from scratch without importing",
    "Import outlines from Plottr, yWriter, Obsidian Longform, and Markdown",
    "Expandable scene beats as writing prompts",
    "Beat management — split, merge, reorder, and delete beats",
    "Inline discovery notes to capture ideas mid-writing",
    "Context-aware character and location references",
    "Command palette for quick access to all actions",
    "Export to DOCX, Markdown, and Obsidian Longform",
    "Local-first — all data stays on your computer",
    "Distraction-free writing interface",
    "Automatic updates — never download manually again",
    "Built with Rust and Tauri for fast performance",
    "Session persistence — pick up where you left off",
    "Free and open source under MIT license"
  ]
};

const faqStructuredData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What file formats does Kindling support?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Kindling imports from Plottr (.pltr), yWriter (.yw7), Obsidian Longform, and Markdown outlines. It exports to DOCX, Markdown, and Obsidian Longform format. This lets you bring in your existing outline and export finished work to the tools you already use."
      }
    },
    {
      "@type": "Question",
      "name": "Is Kindling open source?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Kindling is fully open source under the MIT license. The complete source code is available on GitHub at https://github.com/smith-and-web/kindling. Anyone can inspect, modify, and redistribute the code."
      }
    },
    {
      "@type": "Question",
      "name": "Does Kindling send data to the cloud?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Kindling is a local-first desktop application. Your projects are stored as SQLite files on your hard drive. Kindling does not require an account, does not phone home, does not collect analytics, and does not upload your manuscripts. Your data never leaves your machine."
      }
    },
    {
      "@type": "Question",
      "name": "What is Kindling built with?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Kindling is built with Rust and Tauri 2.x for the backend, providing fast performance and a small ~10MB application size. The user interface is built with Svelte 5. Project data is stored in SQLite databases. It launches in under a second and uses a fraction of the memory of Electron-based writing tools."
      }
    }
  ]
};
---

<MarketingLayout
  title="Kindling Writer Features — Free Fiction Writing Software for Plotters & Pantsers"
  description="Writing software for plotters and pantsers. Rolling outlines, expandable scene beats, character references, command palette, auto-updates. Free & open source."
  structuredData={structuredData}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqStructuredData)} />

  <!-- Lede — left-aligned editorial page opener -->
  <section class="page-lede editorial">
    <h1>Everything you need to go from outline to draft</h1>
    <p class="lede-standfirst">Whether you outline every beat or discover your story as you write, Kindling gives you a scaffolded writing space — scene beats as expandable prompts, character details at your fingertips, and the flexibility to add structure at your own pace.</p>
    <a href="/download/" class="download-btn" onclick="typeof gtag==='function'&&gtag('event','download_cta_click',{cta_location:'features_hero'})">Download Kindling — Free</a>
  </section>

  <!-- ===== Primary features — editorial sequence ===== -->
  <section class="features-seq-section editorial">
    <div class="feature-seq">
      <article class="feature-row fade-in-on-scroll">
        <figure class="feature-figure">
          <Image src={scenePanel} alt="Kindling editor showing scene beats alongside prose" width={560} loading="eager" />
        </figure>
        <div class="feature-prose">
          <p class="kicker">Core Feature</p>
          <h3>Outline-Aware Drafting</h3>
          <p class="feature-problem">Other apps make you flip between your outline and a blank page.</p>
          <p class="feature-solution">Scene beats appear as expandable prompts in your drafting view. Click a beat, write into it. Your outline is the scaffolding for your first draft.</p>
        </div>
      </article>

      <article class="feature-row reverse fade-in-on-scroll">
        <div class="feature-prose">
          <p class="kicker">Stay in Flow</p>
          <h3>References Panel</h3>
          <p class="feature-problem">Was it green eyes or blue? What was the tavern called?</p>
          <p class="feature-solution">Characters and locations tagged in your scene auto-surface in a side panel. Physical descriptions, key notes, and custom fields — all visible while you write.</p>
        </div>
        <figure class="feature-figure">
          <Image src={referencesPanel} alt="Kindling references panel showing character details" width={560} loading="lazy" />
        </figure>
      </article>

      <div class="feature-pair fade-in-on-scroll">
        <div class="feature-prose">
          <p class="kicker">Your Pace</p>
          <h3>Rolling Outline</h3>
          <p class="feature-problem">Not every scene needs the same level of planning.</p>
          <p class="feature-solution">Three planning states — <strong>Fixed</strong>, <strong>Flexible</strong>, <strong>Undefined</strong> — let you add structure progressively. Start vague, define as you go. The sidebar adapts automatically.</p>
        </div>
        <div class="feature-prose">
          <p class="kicker">Full Control</p>
          <h3>Beat Management</h3>
          <p class="feature-problem">Your outline needs to evolve as you write.</p>
          <p class="feature-solution">Delete, reorder, split, and merge beats with drag-and-drop. A beat density indicator shows how detailed each scene is at a glance.</p>
        </div>
      </div>

      <div class="feature-pair fade-in-on-scroll">
        <div class="feature-prose">
          <p class="kicker">Capture Ideas</p>
          <h3>Discovery Notes</h3>
          <p class="feature-problem">Inspiration doesn't wait for your outline.</p>
          <p class="feature-solution">Press <strong>Cmd+D</strong> to jot a note mid-scene — a subplot idea, a character insight, a thread to weave in later. Promote notes to full beats when you're ready.</p>
        </div>
        <div class="feature-prose">
          <p class="kicker">Your Tools</p>
          <h3>Import &amp; Export</h3>
          <p class="feature-problem">Your outline lives in one app, your manuscript in another.</p>
          <p class="feature-solution">Import from Plottr, Scrivener, yWriter, Obsidian, or Markdown. Export to DOCX, Scrivener, Markdown, or EPUB.</p>
          <div class="flow-diagram">
            <div class="flow-node">
              <span class="flow-label">Import</span>
              <span class="flow-formats">Plottr · Scrivener · yWriter · Obsidian · Markdown</span>
            </div>
            <span class="flow-arrow" aria-hidden="true">↓</span>
            <div class="flow-node flow-node-center">
              <span class="flow-label">Kindling</span>
              <span class="flow-formats">Write & edit</span>
            </div>
            <span class="flow-arrow" aria-hidden="true">↓</span>
            <div class="flow-node">
              <span class="flow-label">Export</span>
              <span class="flow-formats">DOCX · Scrivener · Markdown · EPUB</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== New in v1.2 — hairline-separated pairs ===== -->
  <section class="features-seq-section editorial">
    <header class="section-lead">
      <h2>New in v1.2</h2>
    </header>
    <div class="feature-seq">
      <div class="feature-pair fade-in-on-scroll">
        <div class="feature-prose">
          <p class="kicker">Write Your Way</p>
          <h3>Full-Page Prose Editing</h3>
          <p class="feature-problem">Beat-by-beat is great for structure. But sometimes you just want to write.</p>
          <p class="feature-solution">Toggle between beat view and a full-page prose editor per scene. Your beats stay available for reference — you get an uninterrupted writing surface without leaving your structure behind.</p>
        </div>
        <div class="feature-prose">
          <p class="kicker">Smart Context</p>
          <h3>Reference Auto-Detection</h3>
          <p class="feature-problem">You mentioned a character three paragraphs ago but forgot to link them.</p>
          <p class="feature-solution">A non-AI engine scans your prose for character, location, and item names. Suggestions surface in the References panel — link with one click, or dismiss. No cloud, no magic, just pattern matching.</p>
        </div>
      </div>

      <div class="feature-pair fade-in-on-scroll">
        <div class="feature-prose">
          <p class="kicker">Flexible Data</p>
          <h3>Custom Fields &amp; Tags</h3>
          <p class="feature-problem">Plain text notes don't cut it for complex characters and worlds.</p>
          <p class="feature-solution">Define typed fields (text, number, date, select, multi-select) on any reference type. Organise with hierarchical tags up to three levels deep, with colours and a Tag Manager. Use saved filters to find exactly what you need.</p>
        </div>
        <div class="feature-prose">
          <p class="kicker">Screenwriters</p>
          <h3>Screenplay Projects &amp; Templates</h3>
          <p class="feature-problem">Novel tools don't speak the language of screenwriting.</p>
          <p class="feature-solution">Create Screenplay projects with slugline input (INT./EXT.), page count estimation (250 words/page), and treatment export (1-page or 5-page DOCX). Pre-built templates: Save the Cat, Hero's Journey, Three-Act, Seven-Point, Snowflake, Story Grid.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== Everything else — hairline definition list (no emoji) ===== -->
  <section class="features-seq-section editorial">
    <header class="section-lead">
      <h2>And everything else you'd expect</h2>
    </header>
    <dl class="spec-list">
      <div class="spec-item">
        <dt>Command palette</dt>
        <dd>Press Cmd+K to fuzzy-search every action — import, export, settings, navigation.</dd>
      </div>
      <div class="spec-item">
        <dt>Blank projects</dt>
        <dd>Start from scratch with File → New Project. No import required.</dd>
      </div>
      <div class="spec-item">
        <dt>Distraction-free writing</dt>
        <dd>Clean interface. Beats expand only when you need them. No feature overload.</dd>
      </div>
      <div class="spec-item">
        <dt>Local-first &amp; private</dt>
        <dd>SQLite on your hard drive. No cloud, no accounts, no data collection. <a href="/open-source/">Open source.</a></dd>
      </div>
      <div class="spec-item">
        <dt>Built with Rust</dt>
        <dd>Sub-second launch. Fraction of the memory of Electron apps. ~10 MB download.</dd>
      </div>
      <div class="spec-item">
        <dt>Session persistence</dt>
        <dd>Cursor position, scroll state, and active scene — all restored when you reopen.</dd>
      </div>
      <div class="spec-item">
        <dt>Automatic updates</dt>
        <dd>New versions download silently. A banner appears when ready — click to restart.</dd>
      </div>
      <div class="spec-item">
        <dt>Light &amp; dark themes</dt>
        <dd>System preference detection or manual override. Switch from Settings → Appearance.</dd>
      </div>
    </dl>
  </section>

  <!-- ===== Bottom CTA ===== -->
  <section class="cta-section">
    <h2>Ready to spark your draft?</h2>
    <p>Free, open source, MIT licensed. <a href="/compare/" style="color: var(--color-accent-text);">See how Kindling compares</a> to Scrivener, Plottr, and other writing tools.</p>
    <div class="download-buttons single">
      <a href="/download/" class="download-btn" onclick="typeof gtag==='function'&&gtag('event','download_cta_click',{cta_location:'features_bottom'})">Download Kindling — Free</a>
    </div>
  </section>
</MarketingLayout>

<style>
  /* Lede — editorial page opener */
  .page-lede {
    padding-top: 128px;
    padding-bottom: var(--space-2xl);
  }
  .page-lede h1 {
    font-family: var(--font-display);
    font-size: var(--text-hero);
    font-weight: 600;
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    max-width: 18ch;
    margin-bottom: var(--space-m);
  }
  .lede-standfirst {
    font-family: var(--font-body);
    font-size: var(--text-body-lg);
    color: var(--color-text);
    line-height: var(--leading-relaxed);
    max-width: var(--measure);
    margin-bottom: var(--space-l);
  }

  .features-seq-section {
    padding: var(--space-3xl) 0;
  }

  /* Flow diagram — kept from the previous design, lives inside the
     Import & Export prose cell. */
  .flow-diagram {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 4px;
    margin-top: var(--space-m);
  }
  .flow-node {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-l);
    padding: 10px 16px;
    text-align: center;
  }
  .flow-node-center {
    border-color: var(--color-accent);
  }
  .flow-label {
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 13px;
    display: block;
  }
  .flow-formats {
    font-family: var(--font-ui);
    font-size: 12px;
    color: var(--color-text-muted);
  }
  .flow-arrow {
    font-size: 18px;
    color: var(--color-text-muted);
    line-height: 1;
    text-align: center;
  }

  /* Spec list — hairline-separated definition list (replaces the emoji grid) */
  .spec-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: var(--space-2xl);
  }
  .spec-item {
    padding: var(--space-m) 0;
    border-top: 1px solid var(--color-border);
  }
  .spec-item dt {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: 600;
    margin-bottom: var(--space-3xs);
  }
  .spec-item dd {
    font-family: var(--font-body);
    font-size: var(--text-body);
    color: var(--color-text-muted);
    line-height: var(--leading);
    margin: 0;
  }
  .spec-item dd a { color: var(--color-accent-text); text-decoration: none; }
  .spec-item dd a:hover { text-decoration: underline; }

  @media (max-width: 768px) {
    .spec-list { grid-template-columns: 1fr; }
  }
</style>
