---
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import { getCollection } from 'astro:content';
import { breadcrumb, graph, organizationRef } from '../../data/schema';

const allPosts = await getCollection('blog');
const posts = allPosts
  .filter((post) => !post.data.draft)
  .sort((a, b) => new Date(b.data.publishedDate).getTime() - new Date(a.data.publishedDate).getTime());

const structuredData = graph(
  {
    "@type": "Blog",
    "@id": "https://kindlingwriter.com/blog/#blog",
    "name": "kindling Blog",
    "description": "News, updates, and writing tips from the kindling team.",
    "url": "https://kindlingwriter.com/blog/",
    "inLanguage": "en",
    "publisher": organizationRef,
  },
  breadcrumb([["Home", "/"], ["Blog", "/blog/"]]),
);
---

<MarketingLayout
  title="Blog — kindling Writer"
  description="News, updates, and writing tips from the kindling team. Follow along as we build free open-source writing software for plotters and pantsers."
  structuredData={structuredData}
>
  <section class="page-hero">
    <h1>Blog</h1>
    <p class="page-hero-subtext">
      News, updates, and writing tips from the kindling team.
    </p>
  </section>

  <section class="blog-listing">
    <div class="posts-grid">
      {posts.map((post) => {
        const date = new Date(post.data.publishedDate);
        const formatted = date.toLocaleDateString('en-US', {
          timeZone: 'UTC',
          year: 'numeric',
          month: 'long',
          day: 'numeric',
        });
        return (
          <a href={`/blog/${post.id}/`} class="post-card">
            <div class="post-card-inner">
              <div class="post-meta">
                {post.data.tags && post.data.tags.length > 0 && (
                  <span class="post-tag">{post.data.tags[0]}</span>
                )}
                <time datetime={post.data.publishedDate}>{formatted}</time>
              </div>
              <h2>{post.data.title}</h2>
              <p class="post-excerpt">{post.data.description}</p>
              <span class="read-more">Read more &rarr;</span>
            </div>
          </a>
        );
      })}
    </div>
  </section>
</MarketingLayout>

<style>
  /* The same frame and gutter as `.page-hero` above it. This used to be
     `--page-frame` with `--page-gutter`, which put the list 72px left of its
     own heading — three different left edges on one page once the navbar's
     frame is counted. */
  .blog-listing {
    max-width: var(--page-frame-editorial);
    margin: 0 auto;
    padding: 0 24px var(--space-3xl);
  }

  .posts-grid {
    display: flex;
    flex-direction: column;
  }

  .post-card {
    display: block;
    text-decoration: none;
    color: inherit;
    border-top: 1px solid var(--color-border);
    transition: background-color var(--transition);
    /* The hover surface bleeds past the text on both sides instead of stopping
       flush against it. Pulling the row out by the same amount it is padded
       keeps every row's text on the page's left edge, so the highlight reads as
       a band behind the row rather than a box drawn around the words. It stays
       inside the 24px gutter at every width. */
    margin-inline: calc(var(--space-s) * -1);
  }

  .post-card:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  .post-card:hover {
    background: var(--color-surface);
  }

  .post-card-inner {
    padding: var(--space-m) var(--space-s);
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
  }

  .post-tag {
    font-family: var(--font-ui);
    font-size: var(--text-eyebrow);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
    color: var(--color-text-muted);
  }

  .post-meta time {
    font-size: var(--text-small);
    color: var(--color-text-muted);
  }

  .post-card h2 {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: 600;
    margin-bottom: 8px;
    line-height: var(--leading-tight);
    color: var(--color-text);
  }

  .post-excerpt {
    font-family: var(--font-body);
    font-size: var(--text-body);
    color: var(--color-text-muted);
    line-height: var(--leading);
    max-width: var(--measure);
    margin-bottom: 12px;
  }

  /* The whole row is the link, so this is redundant chrome — keep it quiet
     rather than spending a terracotta moment on every row. */
  .read-more {
    font-family: var(--font-ui);
    font-size: var(--text-small);
    font-weight: 500;
    color: var(--color-text-muted);
  }

  .post-card:hover .read-more {
    color: var(--color-accent-text);
  }

  @media (max-width: 600px) {
    .post-card-inner {
      padding: var(--space-s) var(--space-2xs);
    }

    .post-card {
      margin-inline: calc(var(--space-2xs) * -1);
    }
  }
</style>
