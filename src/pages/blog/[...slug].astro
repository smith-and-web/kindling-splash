---
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import SmartDownloadButton from '../../components/SmartDownloadButton.svelte';
import { getCollection, render } from 'astro:content';
import { SITE, absoluteUrl, breadcrumb, graph, organizationRef } from '../../data/schema';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.filter((post) => !post.data.draft).map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

/*
 * Related reading: three other posts. Most posts were reachable from `/blog/`
 * alone, and on 24 Sep 2026 seven of nine were not indexed. A release post
 * leads with the release before it; then come posts that share a tag, then the
 * newest of the rest.
 */
const byNewest = (a, b) => new Date(b.data.publishedDate).getTime() - new Date(a.data.publishedDate).getTime();
const others = (await getCollection('blog'))
  .filter((p) => !p.data.draft && p.id !== post.id)
  .sort(byNewest);
const tags = post.data.tags ?? [];
const sharesTag = (p) => (p.data.tags ?? []).some((tag) => tags.includes(tag));
const previousRelease = tags.includes('announcement')
  ? others.find((p) => p.data.tags?.includes('announcement') &&
      new Date(p.data.publishedDate) < new Date(post.data.publishedDate))
  : undefined;
const related = [...new Set([previousRelease, ...others.filter(sharesTag), ...others].filter(Boolean))].slice(0, 3);

const publishedDate = new Date(post.data.publishedDate);
const formattedDate = publishedDate.toLocaleDateString('en-US', {
  timeZone: 'UTC',
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const postUrl = `${SITE}/blog/${post.id}/`;
const structuredData = graph(
  {
    "@type": "BlogPosting",
    "@id": `${postUrl}#article`,
    "headline": post.data.title,
    "description": post.data.description,
    "datePublished": post.data.publishedDate,
    "dateModified": post.data.modifiedDate || post.data.publishedDate,
    // Article rich results want an image. Posts have no art of their own yet,
    // so they fall back to the site's 1200x630 social card.
    "image": absoluteUrl(post.data.ogImage ?? '/og-image.png'),
    "author": organizationRef,
    "publisher": organizationRef,
    "mainEntityOfPage": { "@type": "WebPage", "@id": postUrl },
    "url": postUrl,
    "inLanguage": "en",
    ...(post.data.tags ? { "keywords": post.data.tags.join(', ') } : {}),
  },
  breadcrumb([["Home", "/"], ["Blog", "/blog/"], [post.data.title, `/blog/${post.id}/`]]),
);
---

<MarketingLayout
  title={post.data.title}
  description={post.data.description}
  ogType="article"
  ogImage={post.data.ogImage}
  structuredData={structuredData}
>
  <Fragment slot="head">
    <meta property="article:published_time" content={post.data.publishedDate} />
    {post.data.modifiedDate && (
      <meta property="article:modified_time" content={post.data.modifiedDate} />
    )}
    {post.data.tags && post.data.tags.map((tag) => (
      <meta property="article:tag" content={tag} />
    ))}
  </Fragment>

  <article class="blog-post">
    <div class="post-header">
      <a href="/blog/" class="back-link">&larr; Back to Blog</a>
      <div class="post-meta">
        {post.data.tags && post.data.tags.length > 0 && (
          <div class="post-tags">
            {post.data.tags.map((tag) => (
              <span class="post-tag">{tag}</span>
            ))}
          </div>
        )}
        <time datetime={post.data.publishedDate}>{formattedDate}</time>
      </div>
      <h1>{post.data.title}</h1>
    </div>

    <div class="article-content">
      <Content />
    </div>

    <div class="post-cta">
      <h3>Try kindling — it's free</h3>
      <p>Your outline, visible while you write. No account required.</p>
      <SmartDownloadButton client:visible location="blog_post" />
    </div>

    {related.length > 0 && (
      <aside class="related-reading" aria-labelledby="related-reading-title">
        <h2 class="related-reading-title" id="related-reading-title">Related reading</h2>
        <ul class="related-list">
          {related.map((item) => (
            <li>
              <a href={`/blog/${item.id}/`} class="related-link">
                <span class="related-name">{item.data.title}</span>
                <span class="related-excerpt">{item.data.description}</span>
              </a>
            </li>
          ))}
        </ul>
      </aside>
    )}

    <footer class="post-footer">
      <a href="/blog/" class="back-link">&larr; Back to Blog</a>
    </footer>
  </article>
</MarketingLayout>

<style>
  /* The text column is exactly --measure; the gutters sit outside it. */
  .blog-post {
    max-width: calc(var(--measure) + 2 * var(--page-gutter));
    margin: 0 auto;
    padding: var(--space-4xl) var(--page-gutter) var(--space-3xl);
  }

  .post-header {
    margin-bottom: 48px;
  }

  .back-link {
    display: inline-block;
    font-family: var(--font-ui);
    font-size: var(--text-small);
    font-weight: 500;
    color: var(--color-accent-text);
    text-decoration: none;
    margin-bottom: 24px;
    transition: opacity var(--transition);
  }

  .back-link:hover {
    opacity: 0.8;
    text-decoration: underline;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
  }

  .post-tags {
    display: flex;
    gap: 8px;
  }

  .post-tag {
    font-family: var(--font-ui);
    font-size: var(--text-eyebrow);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
    color: var(--color-accent-text);
    background: color-mix(in srgb, var(--color-accent) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-accent) 25%, transparent);
    padding: 3px 10px;
    border-radius: var(--radius-pill);
  }

  .post-meta time {
    font-size: var(--text-small);
    color: var(--color-text-muted);
  }

  .post-header h1 {
    font-family: var(--font-display);
    font-size: var(--text-h1);
    font-weight: 600;
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
  }

  /* Article body content */
  .article-content {
    font-family: var(--font-body);
    font-size: var(--text-body);
    line-height: var(--leading-relaxed);
    color: var(--color-text);
  }

  .article-content :global(h2) {
    font-family: var(--font-display);
    font-size: var(--text-h2);
    font-weight: 600;
    margin-top: 48px;
    margin-bottom: 16px;
  }

  .article-content :global(h3) {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: 600;
    margin-top: 36px;
    margin-bottom: 12px;
  }

  .article-content :global(p) {
    margin-bottom: 24px;
  }

  .article-content :global(ul),
  .article-content :global(ol) {
    margin-bottom: 24px;
    padding-left: 28px;
  }

  .article-content :global(li) {
    margin-bottom: 8px;
  }

  .article-content :global(a) {
    color: var(--color-accent-text);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .article-content :global(a:hover) {
    opacity: 0.85;
  }

  .article-content :global(blockquote) {
    border-left: 4px solid var(--color-accent);
    padding: 16px 24px;
    margin: 32px 0;
    background: var(--color-surface);
    border-radius: 0 var(--radius-m) var(--radius-m) 0;
    font-style: italic;
    color: var(--color-text);
  }

  .article-content :global(code) {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: var(--color-surface);
    padding: 2px 6px;
    border-radius: var(--radius-xs);
  }

  .article-content :global(pre) {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-m);
    padding: 20px;
    overflow-x: auto;
    margin: 24px 0;
  }

  .article-content :global(pre code) {
    background: none;
    padding: 0;
    font-size: var(--text-small);
  }

  .article-content :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-m);
    margin: 24px 0;
  }

  .article-content :global(hr) {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: 40px 0;
  }

  .article-content :global(strong) {
    font-weight: 600;
    color: var(--color-text);
  }

  /* Tables — scrolls horizontally on narrow screens instead of crushing cells. */
  .article-content :global(table) {
    display: block;
    width: 100%;
    max-width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    font-family: var(--font-ui);
    font-size: var(--text-ui);
    line-height: var(--leading);
    margin: 32px 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-m);
  }

  .article-content :global(table thead) {
    background: var(--color-surface);
  }

  .article-content :global(table th) {
    font-weight: 600;
    text-align: left;
    color: var(--color-text);
    padding: 12px 16px;
    border-bottom: 1px solid var(--color-border);
    white-space: nowrap;
  }

  .article-content :global(table td) {
    padding: 12px 16px;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text-muted);
  }

  .article-content :global(table tbody tr:last-child td) {
    border-bottom: none;
  }

  .article-content :global(table tbody tr:hover) {
    background: var(--color-surface-sunken);
  }

  /* First column (tool name) deserves emphasis. */
  .article-content :global(table tbody td:first-child) {
    font-weight: 600;
    color: var(--color-text);
    white-space: nowrap;
  }

  /* Post CTA */
  .post-cta {
    margin-top: 48px;
    padding: 32px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    text-align: center;
  }

  .post-cta h3 {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: 600;
    margin-bottom: 8px;
  }

  .post-cta p {
    font-size: var(--text-ui);
    color: var(--color-text-muted);
    margin-bottom: 16px;
    font-family: var(--font-body);
  }

  /* Related reading. The same hairline-row list as `/blog/`, in text colour
     rather than the accent: it sits directly under the CTA, and three accent
     links there would break the two-terracotta-per-viewport rule.
     The element-qualified selectors are needed: `.press-web :where(h1, h2)`
     sizes every h2 as a website title and `.press-web a` colours every link,
     and a bare scoped class only ties with them, then loses on source order.
     See CLAUDE.md on scoped-style specificity. */
  .related-reading {
    margin-top: var(--space-2xl);
  }

  h2.related-reading-title {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: 600;
    line-height: var(--leading-tight);
    margin-bottom: var(--space-s);
  }

  ul.related-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  ul.related-list li {
    border-top: var(--pw-line);
  }

  ul.related-list li:last-child {
    border-bottom: var(--pw-line);
  }

  ul.related-list a.related-link {
    display: block;
    padding: var(--space-s) 0;
    color: var(--color-text);
    text-decoration: none;
  }

  ul.related-list a.related-link:hover .related-name {
    text-decoration: underline;
  }

  .related-name {
    display: block;
    font-family: var(--font-display);
    font-size: var(--text-body-lg);
    font-weight: 600;
    line-height: var(--leading-tight);
  }

  .related-excerpt {
    display: block;
    margin-top: var(--space-2xs);
    font-family: var(--font-body);
    font-size: var(--text-small);
    line-height: var(--leading);
    color: var(--color-text-muted);
  }

  /* Post footer */
  .post-footer {
    margin-top: 64px;
    padding-top: 32px;
    border-top: 1px solid var(--color-border);
  }

  @media (max-width: 600px) {
    .blog-post {
      padding: var(--space-4xl) var(--space-m) var(--space-2xl);
    }

  }
</style>
