---
import MarketingLayout from "../../layouts/MarketingLayout.astro";
import { graph, softwareApplication } from '../../data/schema';
import { APP_VERSION, DOWNLOADS } from "../../data/downloads";

const structuredData = graph(softwareApplication({
  description: "Free open-source fiction writing software that keeps your outline visible while you draft. Import from Plottr, Scrivener, yWriter, or Obsidian.",
}));

const faqStructuredData = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: [
        {
            "@type": "Question",
            name: "Is kindling available on mobile?",
            acceptedAnswer: {
                "@type": "Answer",
                text: "kindling is currently a desktop app for macOS, Windows, and Linux. A mobile version is not available yet.",
            },
        },
        {
            "@type": "Question",
            name: "Is kindling free?",
            acceptedAnswer: {
                "@type": "Answer",
                text: "Yes. kindling is completely free and open source under the MIT license. No account, subscription, or payment required.",
            },
        },
        {
            "@type": "Question",
            name: "What are the system requirements?",
            acceptedAnswer: {
                "@type": "Answer",
                text: "macOS 12 or later, Windows 10 or later, or x86_64 Linux. Under 100 MB of disk space. No internet connection required after download.",
            },
        },
    ],
};

/*
 * Every platform is rendered server-side — its segment, its description, its
 * installer anchor and its checksum command — and CSS reveals the set matching
 * the checked radio. That is what makes the choice work without JavaScript:
 * the visitor picks Linux, the Linux anchor appears, and it is a real link to a
 * real binary. Swapping one anchor's href in script would have left a no-JS
 * visitor unable to reach anything but macOS.
 *
 * This is also why Press's `data-pw-platform` handler is deliberately not
 * wired. It is documented as a local specimen that rewrites a single result
 * element, and CLAUDE.md records the decision not to ship it. The
 * `.pw-platforms` pattern it belongs to — fieldset, legend, explicit choice,
 * live result, no silent detection — is what we are keeping.
 */
const platforms = Object.entries(DOWNLOADS) as [
    string,
    (typeof DOWNLOADS)[keyof typeof DOWNLOADS],
][];

const DESCRIPTIONS: Record<string, string> = {
    mac: `Intel & Apple Silicon, ${DOWNLOADS.mac.size}. Requires macOS 12 (Monterey) or later.`,
    windows: `64-bit installer, ${DOWNLOADS.windows.size}. Requires Windows 10 or later.`,
    linux: `x86_64 AppImage, ${DOWNLOADS.linux.size}. Mark it executable and run it.`,
};

const FILENAMES: Record<string, string> = {
    mac: `Kindling_${APP_VERSION}_universal.dmg`,
    windows: `Kindling_${APP_VERSION}_x64-setup.exe`,
    linux: `Kindling_${APP_VERSION}_amd64.AppImage`,
};

const GLYPHS: Record<string, string> = {
    mac: "M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z",
    windows:
        "M0 3.449L9.75 2.1v9.451H0m10.949-9.602L24 0v11.4H10.949M0 12.6h9.75v9.451L0 20.699M10.949 12.6H24V24l-12.9-1.801",
    linux: "M12.504 0c-.155 0-.315.008-.48.021-4.226.333-3.105 4.807-3.17 6.298-.076 1.092-.3 1.953-1.05 3.02-.885 1.051-2.127 2.75-2.716 4.521-.278.832-.41 1.684-.287 2.489a.424.424 0 00-.11.135c-.26.268-.45.6-.663.839-.199.199-.485.267-.797.4-.313.136-.658.269-.864.68-.09.189-.136.394-.132.602 0 .199.027.4.055.536.058.399.116.728.04.97-.249.68-.28 1.145-.106 1.484.174.334.535.47.94.601.81.2 1.91.135 2.774.6.926.466 1.866.67 2.616.47.526-.116.97-.464 1.208-.946.587-.003 1.23-.269 2.26-.334.699-.058 1.574.267 2.577.2.025.134.063.198.114.333l.003.003c.391.778 1.113 1.132 1.884 1.071.771-.06 1.592-.536 2.257-1.306.631-.765 1.683-1.084 2.378-1.503.348-.199.629-.469.649-.853.023-.4-.2-.811-.714-1.376v-.097l-.003-.003c-.17-.2-.25-.535-.338-.926-.085-.401-.182-.786-.492-1.046h-.003c-.059-.054-.123-.067-.188-.135a.357.357 0 00-.19-.064c.431-1.278.264-2.55-.173-3.694-.533-1.41-1.465-2.638-2.175-3.483-.796-1.005-1.576-1.957-1.56-3.368.026-2.152.236-6.133-3.544-6.139z",
};
---

<MarketingLayout
    title="Download kindling — Free Fiction Writing App for Mac, Windows & Linux"
    description={`Download the kindling app for macOS, Windows, or Linux. Free, open-source fiction writing software — no account required, works offline. Import outlines from Plottr, Scrivener, yWriter, or Obsidian.`}
    downloadContext="download_page"
    structuredData={structuredData}
>
    <script
        type="application/ld+json"
        set:html={JSON.stringify(faqStructuredData)}
    ></script>

    <!-- ===== 01 · Hero. One primary action; the choice drives it. =====
         The right column holds the choice and the action and nothing else.
         Version, licence and the releases link sit on the left: they are page
         metadata, not part of the decision, and carrying them opposite an
         `align-items: end` grid is what pushes the h1 off the top. -->
    <section class="pw-hero pw-frame">
        <div class="pw-hero-grid">
            <div>
                <h1 class="pw-hero-title">Download <em>kindling</em></h1>
                <p class="pw-prose hero-lede">
                    The outline stays beside the draft. Free, open source, and
                    it runs on your own machine — no account, no sync, nothing
                    to cancel.
                </p>
                <div class="pw-row hero-meta">
                    <span class="pw-version">Version {APP_VERSION}</span>
                    <span class="pw-note">
                        MIT licensed ·
                        <a
                            href="https://github.com/smith-and-web/kindling/releases"
                            target="_blank"
                            rel="noopener"
                        >All releases and checksums</a>
                    </span>
                </div>
            </div>

            <div class="pw-stack">
                <fieldset class="pw-platforms" data-platform-picker>
                    <legend>Choose your platform</legend>
                    <!-- `.ka-segment` is the application's own pick-one-of-N:
                         the same control a writer meets on the view toggle,
                         because it is the same decision. -->
                    <div class="ka-segment-track">
                        {platforms.map(([key, platform]) => (
                            <label class="ka-segment">
                                <input
                                    type="radio"
                                    name="platform"
                                    id={`platform-${key}`}
                                    value={key}
                                    checked={key === "mac"}
                                />
                                <span>{platform.label}</span>
                            </label>
                        ))}
                    </div>

                    <div class="pw-platform-result">
                        {platforms.map(([key]) => (
                            <p class="pw-note platform-only" data-for={key}>
                                {FILENAMES[key]} — {DESCRIPTIONS[key]}
                            </p>
                        ))}

                        {platforms.map(([key, platform]) => (
                            <a
                                class="pw-button platform-only"
                                data-for={key}
                                data-platform={key}
                                href={platform.url}
                            >
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    viewBox="0 0 24 24"
                                    fill="currentColor"
                                    aria-hidden="true"
                                >
                                    <path d={GLYPHS[key]} />
                                </svg>
                                <span>Download for {platform.label}</span>
                            </a>
                        ))}
                    </div>
                </fieldset>
                <!-- Pre-select the visitor's desktop OS while the page is still
                     parsing, so the first frame already shows their installer.
                     It never decides: markup checks macOS without script, and a
                     choice the browser restores on back-navigation still wins,
                     because restoration happens after this runs. -->
                <script is:inline>
                    (function () {
                        var d = document.documentElement.dataset;
                        var radio = d.device === "desktop" && d.os && document.getElementById("platform-" + d.os);
                        if (radio) radio.checked = true;
                    })();
                </script>

                <!-- Mobile state. An operational notice, not a bespoke panel:
                     the same .ka-notice and .ka-button a writer meets in the
                     app. Shown by CSS from `data-device`, which platform-detect.js
                     records before first paint — so it is in the first frame on a
                     phone, never on a desktop, and hidden without script. -->
                <div class="ka-notice" data-mobile-notice>
                    <p>
                        <strong>kindling is a desktop app.</strong> It runs on
                        macOS, Windows and Linux — there is no mobile version
                        yet. Send yourself the link and pick it up on your
                        computer.
                    </p>
                    <div class="ka-row">
                        <button
                            type="button"
                            class="ka-button"
                            data-copy-link
                        >
                            Copy download link
                        </button>
                        <a
                            class="ka-button ka-button--secondary"
                            href="mailto:?subject=kindling%20Writer&body=Download%20kindling%20on%20your%20computer%3A%20https%3A%2F%2Fkindlingwriter.com%2Fdownload%2F"
                        >Email it to me</a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ===== Trust band ===== -->
    <section class="pw-band">
        <ul class="pw-trust pw-frame">
            <li>Runs entirely offline</li>
            <li>No account, no telemetry</li>
            <li>Your files stay yours</li>
            <li>MIT licensed source</li>
        </ul>
    </section>

    <!-- ===== 02 · What you're downloading ===== -->
    <section class="pw-frame page-section">
        <div class="page-split">
            <div>
                <p class="pw-label">02 / What you get</p>
                <h2 class="pw-heading">
                    A single application, and nothing beside it
                </h2>
                <p class="pw-prose section-lede">
                    kindling installs one desktop application. No browser
                    extension, no background service, no launch agent, no
                    startup item. Uninstalling it removes the application and
                    leaves every project file where you put it.
                </p>
                <p class="pw-prose section-para">
                    The desktop application collects nothing and transmits
                    nothing. It has no analytics of any kind — that is a
                    property of the software, not a setting you have to find.
                </p>
            </div>

            <div class="ka-panel">
                <header class="ka-between">
                    <h4>Release</h4>
                    <span class="pw-version">{APP_VERSION}</span>
                </header>
                <div class="ka-panel-body panel-stack">
                    <dl class="ka-facts">
                        <div><dt>Type</dt><dd>Desktop application</dd></div>
                        <div><dt>Download</dt><dd>{DOWNLOADS.windows.size} to {DOWNLOADS.linux.size}, by platform</dd></div>
                        <div><dt>Disk</dt><dd>Under 100 MB installed</dd></div>
                        <div><dt>Licence</dt><dd>MIT</dd></div>
                        <div>
                            <dt>Source</dt>
                            <dd>
                                <a
                                    href="https://github.com/smith-and-web/kindling"
                                    target="_blank"
                                    rel="noopener"
                                >GitHub</a>
                            </dd>
                        </div>
                    </dl>
                    <p class="ka-help">
                        Verify the download against the published checksum:
                    </p>
                    <div class="ka-code">
                        {platforms.map(([key]) => (
                            <code class="platform-only" data-for={key}>
                                shasum -a 256 {FILENAMES[key]}
                            </code>
                        ))}
                        <button
                            type="button"
                            class="ka-button ka-button--secondary"
                            data-copy-checksum
                        >
                            Copy
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ===== 03 · First run ===== -->
    <section class="pw-frame page-section">
        <p class="pw-label">03 / First run</p>
        <h2 class="pw-heading">From installer to first scene</h2>
        <ol class="pw-steps steps-block">
            <li class="pw-step">
                <div>
                    <h3>Install and open it</h3>
                    <p>
                        macOS may ask you to confirm the first launch. See the
                        <a href="/code-signing-policy/">code signing policy</a>
                        {" "}for why.
                    </p>
                </div>
            </li>
            <li class="pw-step">
                <div>
                    <h3>Import your outline</h3>
                    <p>
                        Plottr, Scrivener, yWriter, novelWriter, Obsidian or
                        plain Markdown. Nothing is rewritten at the source.
                    </p>
                </div>
            </li>
            <li class="pw-step">
                <div>
                    <h3>Open a scene</h3>
                    <p>
                        Its beats appear beside the manuscript as prompts you
                        can expand, reorder or ignore.
                    </p>
                </div>
            </li>
            <li class="pw-step">
                <div>
                    <h3>Write</h3>
                    <p>
                        The outline stays visible. Nothing you type leaves the
                        machine.
                    </p>
                </div>
            </li>
        </ol>
    </section>

    <!-- ===== 04 · Requirements and removal ===== -->
    <section class="pw-frame page-section" id="uninstall">
        <p class="pw-label">04 / Requirements and removal</p>
        <h2 class="pw-heading">Before and after</h2>
        <div class="disclosure-set">
            <details class="pw-disclosure" open>
                <summary>System requirements</summary>
                <div class="disclosure-body">
                    <dl class="ka-facts">
                        {platforms.map(([, platform]) => (
                            <div>
                                <dt>{platform.label}</dt>
                                <dd>{platform.sysReq}</dd>
                            </div>
                        ))}
                        <div><dt>Disk</dt><dd>Under 100 MB</dd></div>
                        <div>
                            <dt>Network</dt>
                            <dd>Needed to download. Not needed to write.</dd>
                        </div>
                    </dl>
                </div>
            </details>

            <details class="pw-disclosure">
                <summary>How to uninstall</summary>
                <div class="disclosure-body">
                    <p class="pw-prose">
                        Your project files are never removed by an uninstall —
                        they stay wherever you saved them. kindling installs no
                        background services, launch agents or startup items.
                    </p>
                    <dl class="ka-facts disclosure-facts">
                        <div>
                            <dt>macOS</dt>
                            <dd>
                                Drag kindling from Applications to the Trash.
                                Application data, if present, is in
                                <code>
                                    ~/Library/Application
                                    Support/com.kindlingwriter.app/
                                </code>.
                            </dd>
                        </div>
                        <div>
                            <dt>Windows</dt>
                            <dd>
                                Settings → Apps → Installed apps → kindling →
                                Uninstall. Application data, if present, is in
                                <code>%APPDATA%\com.kindlingwriter.app\</code>.
                            </dd>
                        </div>
                        <div>
                            <dt>Linux</dt>
                            <dd>
                                Delete the AppImage and any desktop entry you
                                created. Application data, if present, is in
                                <code>~/.config/com.kindlingwriter.app/</code>.
                            </dd>
                        </div>
                    </dl>
                </div>
            </details>

            <details class="pw-disclosure">
                <summary>Why macOS warns on first launch</summary>
                <div class="disclosure-body">
                    <p class="pw-prose">
                        kindling is notarised but not distributed through the
                        App Store. The
                        <a href="/code-signing-policy/">code signing policy</a>
                        {" "}records what is signed, by whom, and how to verify
                        it yourself.
                    </p>
                </div>
            </details>
        </div>

        <p class="pw-note legal-note">
            By downloading kindling you agree to the
            <a href="/terms/">Terms of Service</a> and
            <a href="/privacy/">Privacy Policy</a>. kindling is released under
            the
            <a
                href="https://opensource.org/licenses/MIT"
                target="_blank"
                rel="noopener"
            >MIT License</a>.
        </p>
    </section>

    <!-- ===== Closing ===== -->
    <section>
        <div class="pw-closing pw-frame">
            <div>
                <h2 class="pw-heading">Tell me when there is a new release</h2>
                <p class="pw-prose section-lede">
                    Release notes only — a few messages a year, no marketing
                    sequence.
                </p>
            </div>
            <form
                class="pw-signup pw-stack"
                data-newsletter-form="release_updates"
                action="https://app.kit.com/forms/8996985/subscriptions"
                method="post"
                target="_blank"
            >
                <div class="ka-field od-field">
                    <label for="newsletter-email">Email address</label>
                    <input
                        type="email"
                        id="newsletter-email"
                        name="email_address"
                        placeholder="you@example.com"
                        autocomplete="email"
                        required
                        aria-describedby="newsletter-help"
                    />
                </div>
                <button type="submit" class="ka-button">Subscribe</button>
                <p class="ka-help" id="newsletter-help">
                    Used for release notes and nothing else. Unsubscribe in one
                    click.
                </p>
            </form>
        </div>
    </section>
</MarketingLayout>

<style>
    /*
     * Page scaffolding only. Every control, every type role and every colour
     * comes from Press — `.pw-steps`, `.pw-version`, `.ka-facts`, `.ka-code`
     * and the `.ka-segment` no-JS selected state all landed upstream in 0.11.0
     * and are vendored, not redefined here.
     *
     * Astro compiles a scoped selector to `.foo:where(.astro-xxxx)`, which adds
     * no specificity — so anything that has to win against a Press rule is
     * qualified with its element name. Nothing here needs to.
     */

    /* Which platform's description, installer and checksum are visible. This
       is the whole no-JS story: the radio is checked in the markup, `:has()`
       reveals the matching set, and the revealed anchor is a real link to a
       real binary. Script adds analytics on top; it is not load-bearing. */
    /* Qualified with the element name and an ancestor on purpose. Astro
       compiles a scoped selector to `.foo:where(.astro-xxxx)` and `:where()`
       adds nothing, so a bare `.platform-only` (0,1,0) loses to Press's
       `.press-web .pw-button` (0,2,0) and every installer stays visible. The
       reveal rules carry `:has(#id)` and outrank both. */
    .pw-platform-result p.platform-only,
    .pw-platform-result a.platform-only,
    .ka-code > code.platform-only {
        display: none;
    }
    .pw-platforms:has(#platform-mac:checked) p[data-for="mac"],
    .pw-platforms:has(#platform-windows:checked) p[data-for="windows"],
    .pw-platforms:has(#platform-linux:checked) p[data-for="linux"] {
        display: block;
    }
    /* The action is a flex row of glyph and label, not an inline anchor. */
    .pw-platforms:has(#platform-mac:checked) a[data-for="mac"],
    .pw-platforms:has(#platform-windows:checked) a[data-for="windows"],
    .pw-platforms:has(#platform-linux:checked) a[data-for="linux"] {
        display: inline-flex;
    }
    /* The checksum sits in the panel, outside the fieldset, so it reads the
       selection from the page rather than from an ancestor. */
    :global(body:has(#platform-mac:checked)) .ka-code > code[data-for="mac"],
    :global(body:has(#platform-windows:checked))
        .ka-code
        > code[data-for="windows"],
    :global(body:has(#platform-linux:checked))
        .ka-code
        > code[data-for="linux"] {
        display: block;
    }

    /* Vertical rhythm. `.pw-hero` and `.pw-closing` bring their own. */
    .page-section {
        padding-block: var(--space-3xl);
    }
    .page-section + .page-section {
        border-top: 1px solid var(--color-border);
    }
    .page-split {
        display: grid;
        grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
        gap: var(--space-2xl);
        align-items: start;
    }

    .hero-lede,
    .section-lede {
        margin-top: var(--space-m);
    }
    .section-para {
        margin-top: var(--space-s);
    }
    .hero-meta {
        margin-top: var(--space-m);
    }
    .steps-block,
    .disclosure-set {
        margin-top: var(--space-l);
    }
    .disclosure-body {
        max-width: var(--measure);
        padding-bottom: var(--space-m);
    }
    .disclosure-facts {
        margin-top: var(--space-m);
    }
    .legal-note {
        margin-top: var(--space-l);
        max-width: var(--measure);
    }
    .panel-stack {
        display: grid;
        gap: var(--space-m);
    }
    .ka-notice .ka-row {
        margin-top: var(--space-2xs);
    }

    /* A phone visitor should meet "this is a desktop app" before the platform
       choice, not after it. The notice is authored after the fieldset so a
       no-JS desktop visitor never sees it above the download.

       It used to be revealed by a module script after first paint, which
       pushed the platform picker down on every phone: PageSpeed measured the
       layout shift at up to 0.15. `data-device` is recorded before paint, so
       the notice is laid out in the first frame. Without script the attribute
       is never set and the notice stays hidden, as before. */
    :global(html:not([data-device="mobile"])) .pw-stack > [data-mobile-notice] {
        display: none;
    }

    :global(html[data-device="mobile"]) .pw-stack > [data-mobile-notice] {
        order: -1;
    }

    @media (max-width: 767px) {
        .page-split {
            grid-template-columns: minmax(0, 1fr);
            gap: var(--space-l);
        }
        .page-section {
            padding-block: var(--space-2xl);
        }
    }
</style>

<script>
    import { detectPlatform } from "../../scripts/platform";
    import { requestDownload, isPlatform } from "../../scripts/download-flow";

    const { isMobile } = detectPlatform();

    if (isMobile) {
        /*
         * The notice itself is shown by CSS before first paint (see the
         * `data-device` rules above); the desktop pre-selection runs inline
         * after the fieldset. What remains here is demoting the installer to
         * the secondary treatment. Without it the first mobile viewport
         * carries three terracotta moments — the hero `em`, the copy action
         * and the installer — against a budget of two. Same dimensions, so
         * this changes colour, never layout.
         */
        document
            .querySelectorAll<HTMLAnchorElement>("a[data-platform]")
            .forEach((a) => a.classList.add("pw-button--secondary"));
    }

    /*
     * Navigate to /thanks/ and start the file download from there. Doing both
     * here races Chrome's download pipeline against the main-frame navigation
     * and cancels the download.
     */
    document
        .querySelectorAll<HTMLAnchorElement>("a[data-platform]")
        .forEach((action) => {
            action.addEventListener("click", (event) => {
                const key = action.dataset.platform;
                if (isPlatform(key))
                    requestDownload(event, key, "download_page");
            });
        });

    function flash(button: HTMLElement, done: string, fallback: string) {
        return async (text: string) => {
            const label = button.textContent;
            try {
                await navigator.clipboard.writeText(text);
                button.textContent = done;
            } catch {
                button.textContent = fallback;
            }
            window.setTimeout(() => {
                button.textContent = label;
            }, 2500);
        };
    }

    const copyButton =
        document.querySelector<HTMLButtonElement>("[data-copy-link]");
    if (copyButton) {
        const run = flash(
            copyButton,
            "Link copied",
            "Press and hold the address bar to copy",
        );
        copyButton.addEventListener("click", async () => {
            await run("https://kindlingwriter.com/download/");
            if (typeof gtag === "function") {
                gtag("event", "mobile_share", {
                    method: "clipboard",
                    cta_location: "download_page",
                });
            }
        });
    }

    const copyChecksum =
        document.querySelector<HTMLButtonElement>("[data-copy-checksum]");
    if (copyChecksum) {
        const run = flash(copyChecksum, "Copied", "Select and copy manually");
        copyChecksum.addEventListener("click", () => {
            // Whichever command the current selection reveals.
            const visible = [
                ...document.querySelectorAll<HTMLElement>(".ka-code > code"),
            ].find((code) => code.offsetParent !== null);
            if (visible) run(visible.textContent?.trim() ?? "");
        });
    }
</script>
