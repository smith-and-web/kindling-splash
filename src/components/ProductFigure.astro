---
/*
 * A product screenshot in the shared full-frame treatment.
 *
 * `.pw-image-frame` letterboxes inside `--pw-reference-ratio` instead of
 * cropping, and this sets that ratio from the capture's own intrinsic
 * dimensions — so the frame matches the image exactly: nothing cropped, nothing
 * letterboxed, at every width.
 *
 * It replaces the mounted print (`.feature-figure img`, `object-fit: cover` at
 * `max-height: 440px`), which decided how much of an interface a visitor saw
 * from the capture's aspect ratio. That coupling is why the screenshot script
 * carries a `minAspect` per target and why a stacked layout once cut 127px off
 * three of four figures. A figure that cannot crop needs no ratio contract.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  width?: number;
  loading?: 'eager' | 'lazy';
  class?: string;
  /*
   * `intrinsic` (the default) matches the frame to this capture's own ratio, so
   * a standalone figure neither crops nor letterboxes.
   *
   * `inherit` leaves the ratio to an ancestor. A *sequence* of figures is a
   * different problem from a single one: four captures at 1.25/1.25/1.95/1.25
   * in one column stand 424/424/272/424px tall, and a run of rows that are each
   * individually perfect reads as ragged. Setting one ratio on
   * `.pw-feature-grid` and letting every frame letterbox into it makes the run
   * even, and `.pw-image-frame` contains rather than crops, so nothing is lost.
   */
  ratio?: 'intrinsic' | 'inherit';
}

const {
  src,
  alt,
  width = 560,
  loading = 'lazy',
  class: className,
  ratio = 'intrinsic',
} = Astro.props;

const frameStyle =
  ratio === 'intrinsic' ? `--pw-reference-ratio: ${src.width} / ${src.height}` : undefined;
---

{/* `.pw-figure` and the caption role come from Press 0.12.0; the local
    figcaption styling this component used to carry is gone. */}
<figure class:list={['pw-figure', 'product-figure', className]}>
  <div class="pw-image-frame" style={frameStyle}>
    <Image src={src} alt={alt} width={width} loading={loading} />
  </div>
  {Astro.slots.has('default') && <figcaption><slot /></figcaption>}
</figure>

<style>
  .product-figure { min-width: 0; }
</style>
