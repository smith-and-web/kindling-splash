---
/*
 * The Press masthead: `.pw-header` + `.pw-nav`, with the shared in-flow
 * navigation disclosure from website.js. Nothing here styles the nav — the
 * previous version carried its own fixed positioning, stacking values, blur
 * and breakpoint, which is exactly the local reimplementation this adoption
 * removes. Routing, active state and download attribution stay site business.
 */
import wordmark from "../vendor/press/assets/svg/kindling-wordmark.svg?raw";

const currentPath = Astro.url.pathname;

// Read the signature's dimensions from the asset rather than repeating them.
// The old navbar hard-coded width 6790, which described the previous lettering
// and silently stopped matching when the lowercase wordmark was recut to 6445.
const viewBox = wordmark.match(/viewBox="0 0 ([\d.]+) ([\d.]+)"/);
const wordmarkWidth = Number(viewBox?.[1] ?? 6445);
const wordmarkHeight = Number(viewBox?.[2] ?? 1972);

// Download is intentionally omitted from the link row — the header's own
// Download action is the one affordance, and it is secondary so an in-content
// download keeps the only primary fill in view (DESIGN.md, one main action).
const links = [
    { href: "/features/", label: "Features" },
    { href: "/compare/", label: "Compare" },
    { href: "/open-source/", label: "Open source" },
    { href: "/blog/", label: "Blog" },
    { href: "/docs/getting-started/", label: "Docs" },
    { href: "/feedback/", label: "Contact" },
];

function isActive(href: string): boolean {
    if (href === "/") return currentPath === "/";
    return currentPath.startsWith(href);
}
---

<header class="pw-header">
    <nav class="pw-nav pw-frame" data-pw-nav aria-label="Primary">
        <a href="/" class="pw-brand" aria-label="kindling — home">
            <img
                src="/brand/kindling-wordmark.svg"
                width={wordmarkWidth}
                height={wordmarkHeight}
                alt="kindling"
            />
        </a>
        <button
            class="pw-menu"
            type="button"
            aria-expanded="false"
            aria-controls="primary-nav-links"
            data-pw-menu
        >
            Menu
        </button>
        <div class="pw-nav-links" id="primary-nav-links" data-pw-links>
            {links.map((link) => (
                <a
                    href={link.href}
                    aria-current={isActive(link.href) ? "page" : undefined}
                >
                    {link.label}
                </a>
            ))}
            {/*
              Always secondary. WEBSITE_COMPONENTS.md: "use the secondary
              treatment for a persistent header download so the in-content
              action keeps the only primary fill in view." This was previously
              demoted on /download/ alone, so every other page — the home page
              worst of all — showed the masthead's terracotta Download fill and
              the hero's, the same word in the same shape 250px apart, and no
              primary at all. A persistent header action is secondary to
              whatever the page itself is asking for, on every route.
            */}
            <a
                href="/download/"
                class:list={["pw-button", "pw-button--secondary", "navbar-cta"]}
                aria-current={isActive("/download/") ? "page" : undefined}
            >
                Download
            </a>
        </div>
    </nav>
</header>

<script>
    // The shared disclosure controller. It binds [data-pw-nav] once, sets
    // data-pw-ready only after its handlers are attached, and leaves every link
    // visible without it — the CSS collapse is gated on that attribute.
    import "../vendor/press/design-system/website.js";
</script>
