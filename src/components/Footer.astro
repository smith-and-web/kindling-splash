---
/*
 * The Press footer: `.pw-footer` with its top/bottom rows. Routes, legal links
 * and external destinations are unchanged; only the styling authority moved.
 * The italic Newsreader tagline and the wordmark signature are the two site
 * additions, and both are composed from shared tokens.
 */
import wordmark from '../vendor/press/assets/svg/kindling-wordmark.svg?raw';

const viewBox = wordmark.match(/viewBox="0 0 ([\d.]+) ([\d.]+)"/);
const wordmarkWidth = Number(viewBox?.[1] ?? 6445);
const wordmarkHeight = Number(viewBox?.[2] ?? 1972);

/*
 * One row, not four labelled columns.
 *
 * The four-column wall was the tallest thing on every page and read as a
 * sitemap rather than a footer. This is the prototype's lighter shape: the
 * signature and its tagline on the left, the routes a reader actually leaves
 * by on the right, and one quiet legal line underneath.
 *
 * Restructuring the footer dropped no destination: the primary routes are in
 * the row, the off-site and legal ones in the closing line. The legal routes
 * should stay reachable from every page, and `/story-outlining-software/` and
 * `/plottr-vs-scrivener/` are landing pages that depend on internal links
 * (`check-launch.mjs` asserts contextual inlinks). The four social profiles
 * removed below went separately and deliberately — see the note on `secondary`.
 */
const primary = [
  { href: '/features/', label: 'Features' },
  { href: '/download/', label: 'Download' },
  { href: '/compare/', label: 'Compare' },
  { href: '/open-source/', label: 'Open source' },
  { href: '/docs/getting-started/', label: 'Docs' },
  { href: '/blog/', label: 'Blog' },
  { href: '/faq/', label: 'FAQ' },
  { href: '/story-outlining-software/', label: 'Story outlining' },
  { href: '/plottr-vs-scrivener/', label: 'Plottr vs Scrivener' },
  { href: '/feedback/', label: 'Send feedback' },
];

/*
 * Off-site and legal. Twitter/X, Bluesky, Instagram and Mastodon were removed
 * on 15 Sep 2026 — social is not a channel this project is working. GitHub and
 * Discord stay because they are where the software and its users actually are,
 * not because they are social links.
 *
 * The Mastodon entry carried `rel="me"`, which is what verifies a profile's
 * link back to this site; that verification lapses with it. It was the only
 * `rel="me"` on the site, so the `me` flag is gone from the model too.
 */
const secondary = [
  { href: 'https://github.com/smith-and-web/kindling', label: 'GitHub', external: true },
  { href: 'https://discord.gg/g7bkj4kY8w', label: 'Discord', external: true },
  { href: 'https://opensource.org/licenses/MIT', label: 'MIT License', external: true },
  { href: '/privacy/', label: 'Privacy policy' },
  { href: '/terms/', label: 'Terms of service' },
  { href: '/code-signing-policy/', label: 'Code signing policy' },
];
---

<footer class="pw-footer">
  <div class="pw-frame">
    <div class="pw-footer-top">
      <div class="footer-signature">
        <a href="/" class="pw-brand" aria-label="kindling — home">
          <img src="/brand/kindling-wordmark.svg" width={wordmarkWidth} height={wordmarkHeight} alt="kindling">
        </a>
        <p class="footer-tagline">Your words, your data, forever.</p>
      </div>
      <ul class="pw-footer-links footer-primary">
        {primary.map(link => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </div>
    <div class="pw-footer-bottom">
      <p>&copy; 2026 kindling. Free and open source.</p>
      <ul class="pw-footer-links footer-secondary">
        {secondary.map(link => (
          <li>
            <a
              href={link.href}
              rel={link.external ? 'noopener' : undefined}
              target={link.external ? '_blank' : undefined}
            >{link.label}</a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</footer>

<style>
  /* Content arrangement only. The surface, hairlines, link targets and type
     roles are `.pw-footer` / `.pw-footer-links` / `.pw-label`. */
  .footer-signature {
    flex: 0 1 auto;
    max-width: 16rem;
  }

  .footer-signature .pw-brand {
    width: 120px;
  }

  /* `ul.footer-primary` (0,2,0) rather than a bare class: Astro scopes with
     `:where(.astro-xxxx)`, which adds no specificity, so `.footer-primary`
     alone only ties with `.press-web .pw-footer-links` and loses on source
     order. See CLAUDE.md. */
  ul.footer-primary,
  ul.footer-secondary {
    list-style: none;
    margin: 0;
    padding: 0;
    justify-content: flex-end;
    column-gap: var(--space-m);
  }

  ul.footer-primary {
    flex: 1 1 28rem;
    min-width: 0;
  }

  /* The closing line's own routes — source, chat, licence and legal. Smaller
     company than the primary row and set beside the copyright, not above it. */
  ul.footer-secondary {
    flex: 1 1 24rem;
    column-gap: var(--space-s);
  }

  @media (max-width: 767px) {
    ul.footer-primary,
    ul.footer-secondary {
      justify-content: flex-start;
    }
  }

  .footer-tagline {
    margin-top: var(--space-2xs);
    font-family: var(--font-body);
    font-style: italic;
    font-size: var(--text-body-lg);
    line-height: var(--leading);
    color: var(--color-text);
  }

</style>
